@page "/catalog/manage"
@attribute [Authorize]
@layout MainLayout
@using Aenaon.Application.Catalog
@using Aenaon.Application.Tenancy
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject TenantWorkspaceResolver WorkspaceResolver
@inject WorkspacePreferenceService Preference
@inject CatalogWriteService Manager
@inject CatalogEditorDraftStore Drafts
@inject ILogger<CatalogManage> Logger

<PageTitle>@Heading | Aenaon ERP</PageTitle>

<main class="dashboard">
    <BackOfficeSidebar ActivePage="catalog" TenantId="@TenantId" StoreId="@StoreId" />
    <div class="dashboard__content">
        <BackOfficeTopbar ActivePage="catalog" PageTitle="@Heading" BreadcrumbSection="@CatalogSection" BreadcrumbSectionHref="@CatalogSectionHref"
                          UserName="@_userName" Workspace="@_workspace"
                          CsrfToken="@_csrfToken" TenantId="@TenantId" StoreId="@StoreId" />
        <div class="dashboard__body catalog-page catalog-manage-page">
            <div class="dashboard__heading">
                <div>
                    <p class="eyebrow eyebrow--green">ΚΑΤΑΛΟΓΟΣ / ΔΙΑΧΕΙΡΙΣΗ</p>
                    <h1>@Heading</h1>
                    <p>Συμπληρώστε τα βασικά στοιχεία του καταλόγου.</p>
                </div>
                <a class="button button--outline" href="@EditorCancelUrl">
                    <AppIcon Name="chevron" />
                    @(_returnEditor is null ? "Επιστροφή στον κατάλογο" : "Πίσω στην καταχώρηση")
                </a>
            </div>

            @if (!string.IsNullOrWhiteSpace(SavedCode) && !_error && !_denied)
            {
                <div class="catalog-success" role="status">
                    <AppIcon Name="check" /> Η καταχώρηση με κωδικό @SavedCode αποθηκεύτηκε.
                </div>
            }

            @if (_error)
            {
                <div class="form-alert" role="alert">
                    Η διαχείριση δεν είναι διαθέσιμη. Ελέγξτε τη σύνδεση με τη βάση.
                </div>
            }
            else if (_denied)
            {
                <div class="workspace-alert" role="alert">
                    Δεν έχετε δικαίωμα διαχείρισης του καταλόγου αυτής της επιχείρησης.
                </div>
            }
            else if (_missing)
            {
                <div class="workspace-alert" role="alert">
                    Η καταχώρηση δεν υπάρχει ή δεν ανήκει στον επιλεγμένο κατάλογο.
                </div>
            }
            else if (_details is not null)
            {
                @if (!string.IsNullOrEmpty(CurrentError))
                {
                    <div class="form-alert" role="alert">
                        @ErrorMessage
                    </div>
                }

                <section class="surface-card catalog-editor">
                    <div class="catalog-editor__header">
                        <div>
                            <h2>Βασικά στοιχεία</h2>
                            <p>Τα υποχρεωτικά πεδία σημειώνονται με *.</p>
                        </div>
                        @if (_details.Record is { } record)
                        {
                            <span class="catalog-status @(record.IsActive
                                ? "catalog-status--active" : "catalog-status--inactive")">
                                @StatusLabel(record.IsActive)
                            </span>
                        }
                    </div>

                    @if (View is not "categories" && _details.Categories.Count == 0)
                    {
                        <div class="workspace-alert" role="status">
                            Δεν υπάρχουν ακόμη ενεργές κατηγορίες. Χρησιμοποιήστε το κουμπί
                            «Δημιουργία νέας κατηγορίας» στην επιλογή κατηγορίας. Τα στοιχεία σας θα διατηρηθούν.
                        </div>
                    }
                    @if (_returnEditor is not null)
                    {
                        <div class="catalog-editor__return" role="status">
                            <AppIcon Name="check" />
                            Μετά τη δημιουργία της κατηγορίας θα επιστρέψετε
                            @( _returnEditor.View == "services" ? "στην υπηρεσία" : "στο προϊόν" )
                            που συμπληρώνατε, χωρίς να χαθούν τα στοιχεία σας.
                        </div>
                    }



                    <form class="catalog-editor__form" method="post" action="/ui/catalog/save">
                        <input type="hidden" name="__RequestVerificationToken" value="@_csrfToken" />
                        <input type="hidden" name="tenantId" value="@_workspace!.Tenant!.TenantId" />
                        @if (_workspace.Store is { } selectedStore)
                        {
                            <input type="hidden" name="storeId" value="@selectedStore.StoreId" />
                        }
                        <input type="hidden" name="view" value="@View" />
                        @if (_returnEditor is not null && ReturnDraftToken.HasValue)
                        {
                            <input type="hidden" name="returnDraft" value="@ReturnDraftToken" />
                        }
                        <input type="hidden" name="requestId" value="@_requestId" />
                        <input type="hidden" name="action" value="@(Id.HasValue ? "update" : "create")" />
                        @if (Id.HasValue)
                        {
                            <input type="hidden" name="id" value="@Id" />
                        }

                        <div class="catalog-editor__grid">
                            <div class="catalog-editor__field">
                                <label for="edit-code" data-code-label>Κωδικός @(IsAutoCode ? "(αυτόματος)" : "*")</label>
                                @if (!Id.HasValue)
                                {
                                    <div class="catalog-code-mode" role="group"
                                         aria-label="Τρόπος απόδοσης κωδικού">
                                        <label>
                                            <input type="radio" name="codeMode" value="auto"
                                                   data-code-mode="auto" checked="@IsAutoCode" />
                                            <span>Αυτόματος</span>
                                        </label>
                                        <label>
                                            <input type="radio" name="codeMode" value="manual"
                                                   data-code-mode="manual" checked="@(!IsAutoCode)" />
                                            <span>Χειροκίνητος</span>
                                        </label>
                                    </div>
                                }
                                <input id="edit-code" name="code" autocomplete="off"
                                       required="@(!IsAutoCode)" disabled="@IsAutoCode"
                                       maxlength="@(View == "categories" ? 30 : 40)"
                                       value="@CurrentCode" placeholder="π.χ. 1, 2, 3 ή δικός σας κωδικός" />
                                <small data-auto-code-hint hidden="@(!IsAutoCode)">
                                    Ο κωδικός θα δημιουργηθεί αυτόματα κατά την αποθήκευση
                                    (1, 2, 3…). Δεν χρειάζεται να τον συμπληρώσετε.
                                </small>
                                <small data-manual-code-hint hidden="@IsAutoCode">
                                    Μπορείτε να γράψετε δικό σας κωδικό με γράμματα, αριθμούς, - ή _.
                                </small>
                                @if (CurrentError is "duplicate" or "code")
                                {
                                    <small class="catalog-editor__error">Ελέγξτε τον κωδικό: @ErrorMessage</small>
                                }
                            </div>
                            <div class="catalog-editor__field">
                                <label for="edit-name">Περιγραφή *</label>
                                <input id="edit-name" name="name" required autocomplete="off"
                                       maxlength="@(View == "categories" ? 160 : 200)"
                                       value="@CurrentName" placeholder="Περιγραφή καταχώρησης" />
                            </div>
                            <div class="catalog-editor__field catalog-editor__field--wide">
                                <CatalogCategoryPicker
                                    TenantId="@_workspace!.Tenant!.TenantId"
                                    FieldName="@(View == "categories" ? "parentCategoryId" : "categoryId")"
                                    Label="@(View == "categories" ? "Γονική κατηγορία" : "Κατηγορία")"
                                    EmptyLabel="@(View == "categories" ? "Καμία — κύρια κατηγορία" : "Επιλέξτε κατηγορία")"
                                    SelectedId="@CurrentSelectedCategory"
                                    ExcludedCategoryId="@(View == "categories" ? Id : null)"
                                    IsRequired="@(View != "categories")"
                                    AllowCreate="@(View != "categories")"
                                    Categories="@_details.Categories" />
                                @if (CurrentError is "category" or "parent")
                                {
                                    <small class="catalog-editor__error">@ErrorMessage</small>
                                }
                            </div>

                            @if (View == "products")
                            {
                                <label class="catalog-editor__checkbox catalog-editor__field--wide">
                                    <input type="checkbox" name="tracksStock" value="true"
                                           checked="@CurrentTracksStock" />
                                    Παρακολούθηση αποθέματος
                                </label>
                            }
                        </div>

                        <div class="catalog-editor__footer">
                            <button type="submit" class="button button--primary"
                                    name="saveMode" value="close" data-catalog-save
                                    disabled="@(View != "categories" && _details.Categories.Count == 0)">
                                <AppIcon Name="check" /> @(Id.HasValue ? "Αποθήκευση" : "Δημιουργία")
                            </button>
                            <button type="submit" name="saveMode" value="new"
                                    class="button button--outline" data-catalog-save
                                    disabled="@(View != "categories" && _details.Categories.Count == 0)">
                                Αποθήκευση και νέο
                            </button>
                            <a class="button button--outline" href="@EditorCancelUrl">Ακύρωση</a>
                        </div>
                        @* Το κρυφό quick-create submitter πρέπει να ακολουθεί την κύρια αποθήκευση:
                           το Enter στα κανονικά πεδία ενεργοποιεί την αποθήκευση, όχι τη γρήγορη δημιουργία. *@
                        @if (View is "products" or "services")
                        {
                            <button hidden type="submit" data-category-quick-submit
                                    formnovalidate formaction="/ui/catalog/new-category"
                                    formmethod="post" tabindex="-1"
                                    aria-hidden="true"></button>
                        }
                    </form>

                    @if (_details.Record is { } existing)
                    {
                        <div class="catalog-editor__danger">
                            <div>
                                <strong>@(existing.IsActive ? "Απενεργοποίηση" : "Ενεργοποίηση")</strong>
                                <p>Δεν διαγράφονται δεδομένα ούτε μεταβάλλονται συνδεδεμένα είδη.</p>
                            </div>
                            <form method="post" action="/ui/catalog/save" class="catalog-state-form">
                                <input type="hidden" name="__RequestVerificationToken" value="@_csrfToken" />
                                <input type="hidden" name="tenantId" value="@_workspace!.Tenant!.TenantId" />
                                <input type="hidden" name="view" value="@View" />
                                <input type="hidden" name="id" value="@existing.Id" />
                                <input type="hidden" name="action"
                                       value="@(existing.IsActive ? "deactivate" : "activate")" />
                                <button type="submit" class="button button--outline">
                                    @(existing.IsActive ? "Απενεργοποίηση" : "Ενεργοποίηση")
                                </button>
                            </form>
                        </div>
                    }
                </section>
                <p class="catalog-disclaimer">
                    Δεν καταχωρούνται τιμές, ΦΠΑ, φορολογικοί χαρακτηρισμοί ή υπόλοιπα αποθήκης.
                    Η επιλογή «Παρακολούθηση αποθέματος» δεν αποτελεί κίνηση αποθήκης.
                </p>
            }
        </div>
        <footer class="dashboard__footer">
            © @DateTime.UtcNow.Year Aenaon ERP · by MoonHard
            <span>Built with .NET &amp; Blazor</span>
        </footer>
    </div>
</main>

@code {
    [SupplyParameterFromQuery(Name = "view")]
    public string? View { get; set; }

    [SupplyParameterFromQuery(Name = "id")]
    public Guid? Id { get; set; }

    [SupplyParameterFromQuery(Name = "tenantId")]
    public Guid? TenantId { get; set; }

    [SupplyParameterFromQuery(Name = "storeId")]
    public Guid? StoreId { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "draft")]
    public Guid? DraftToken { get; set; }

    [SupplyParameterFromQuery(Name = "savedCode")]
    public string? SavedCode { get; set; }

    [SupplyParameterFromQuery(Name = "returnDraft")]
    public Guid? ReturnDraftToken { get; set; }

    private TenantWorkspaceSnapshot? _workspace;
    private CatalogManageDetails? _details;
    private string? _csrfToken;
    private string _userName = "Χρήστης";
    private CatalogEditorDraft? _draft;
    private CatalogEditorDraft? _returnEditor;
    private Guid _requestId = Guid.NewGuid();
    private bool _denied;
    private bool _missing;
    private bool _error;

    private CatalogManagedEntity SelectedEntity => View switch
    {
        "categories" => CatalogManagedEntity.Category,
        "services" => CatalogManagedEntity.Service,
        _ => CatalogManagedEntity.Product
    };

    private string StatusLabel(bool active) =>
        View is "categories" or "services"
            ? (active ? "Ενεργή" : "Ανενεργή")
            : (active ? "Ενεργό" : "Ανενεργό");

    private string EntityLabel => View switch
    {
        "categories" => "κατηγορίας",
        "services" => "υπηρεσίας",
        _ => "προϊόντος"
    };

    private bool IsAutoCode => !Id.HasValue && (_draft?.AutoCode ?? true);
    private string CurrentCode => _draft?.Code ?? _details?.Record?.Code ?? "";
    private string CurrentName => _draft?.Name ?? _details?.Record?.Name ?? "";
    private Guid? CurrentSelectedCategory => View == "categories"
        ? (_draft is not null ? _draft.ParentCategoryId : _details?.Record?.ParentCategoryId)
        : (_draft is not null ? _draft.CategoryId : _details?.Record?.CategoryId);
    private bool CurrentTracksStock =>
        _draft?.TracksStock ?? _details?.Record?.TracksStock ?? false;

    private string? CurrentError => _draft?.ErrorCode ?? Error;
    private string ErrorMessage => CurrentError switch
    {
        "duplicate" => "Ο κωδικός χρησιμοποιείται ήδη στην επιχείρηση.",
        "code" => "Δεν υπάρχουν διαθέσιμοι αριθμητικοί κωδικοί.",
        "category" => "Επιλέξτε έγκυρη και ενεργή κατηγορία.",
        "parent" => "Μη έγκυρη γονική κατηγορία ή δημιουργία κύκλου.",
        "inuse" => "Η κατηγορία έχει ενεργά είδη ή ενεργές υποκατηγορίες.",
        _ => "Τα στοιχεία δεν είναι έγκυρα. Ελέγξτε τα απαιτούμενα πεδία."
    };

    private string Heading => (View, Id.HasValue) switch
    {
        ("categories", true) => "Επεξεργασία κατηγορίας",
        ("categories", false) => "Νέα κατηγορία",
        ("services", true) => "Επεξεργασία υπηρεσίας",
        ("services", false) => "Νέα υπηρεσία",
        (_, true) => "Επεξεργασία προϊόντος",
        _ => "Νέο προϊόν"
    };

    private string CatalogSection => View switch
    {
        "categories" => "Κατηγορίες",
        "services" => "Υπηρεσίες",
        _ => "Προϊόντα"
    };

    private string CatalogSectionHref => BackUrl;

    private string BackUrl
    {
        get
        {
            string url = "/catalog?view=" + (View is "products" or "services" or "categories" ? View : "products");
            if (_workspace?.Tenant is { } tenant)
            {
                url += $"&tenantId={tenant.TenantId:D}";
                if (_workspace.Store is { } store)
                {
                    url += $"&storeId={store.StoreId:D}";
                }
            }

            return url;
        }
    }

    private string EditorCancelUrl
    {
        get
        {
            if (_returnEditor is null || !ReturnDraftToken.HasValue ||
                _workspace?.Tenant is not { } tenant)
            {
                return BackUrl;
            }

            string itemId = _returnEditor.Id is { } id ? $"&id={id:D}" : "";
            string store = _returnEditor.StoreId.HasValue
                ? $"&storeId={_returnEditor.StoreId.Value:D}" : "";
            return $"/catalog/manage?view={_returnEditor.View}&tenantId={tenant.TenantId:D}" +
                store + itemId + $"&draft={ReturnDraftToken.Value:D}";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _error = false;
        _denied = false;
        _missing = false;
        _details = null;
        _draft = null;
        _returnEditor = null;
        _requestId = Guid.NewGuid();

        HttpContext? context = HttpContextAccessor.HttpContext;
        if (context?.Request.IsHttps != true ||
            context.User.Identity?.IsAuthenticated != true ||
            !Guid.TryParse(context.User.FindFirstValue(ClaimTypes.NameIdentifier), out Guid userId) ||
            userId == Guid.Empty)
        {
            _denied = true;
            return;
        }

        _userName = context.User.Identity.Name ?? "Χρήστης";
        _csrfToken = Antiforgery.GetAndStoreTokens(context).RequestToken;
        context.Response.Headers.CacheControl = "no-store";

        try
        {
            if (View is not ("categories" or "products" or "services") || Id == Guid.Empty)
            {
                _missing = true;
                return;
            }

            Guid? requestedTenant = TenantId;
            Guid? requestedStore = StoreId;
            if (!TenantId.HasValue && !StoreId.HasValue &&
                Preference.TryRead(context, userId, out Guid preferredTenant, out Guid? preferredStore))
            {
                requestedTenant = preferredTenant;
                requestedStore = preferredStore;
            }

            _workspace = await WorkspaceResolver.ResolveAsync(
                userId, requestedTenant, requestedStore, context.RequestAborted);
            if (_workspace.Status is not (TenantWorkspaceStatus.Ready or TenantWorkspaceStatus.NoStores))
            {
                _denied = true;
                return;
            }

            CatalogManageResult result = await Manager.GetDetailsAsync(
                userId, _workspace.Tenant!.TenantId, SelectedEntity, Id, context.RequestAborted);
            _denied = !result.IsAuthorized;
            _details = result.Details;
            _missing = !_denied && (_details is null ||
                (Id.HasValue && _details.Record is null));
            if (!_denied && !_missing && View == "categories" &&
                !Id.HasValue && ReturnDraftToken is { } returnToken)
            {
                _returnEditor = Drafts.ReadCategoryReturn(
                    returnToken, userId, _workspace.Tenant.TenantId);
            }
            if (!_denied && !_missing && DraftToken is { } token)
            {
                _draft = Drafts.Read(token, userId, _workspace.Tenant.TenantId, Id, View!);
                if (_draft is not null && CurrentSelectedCategory is { } categoryId &&
                    _details is not null &&
                    _details.Categories.All(option => option.Id != categoryId))
                {
                    // Μετά από validation error διατηρούμε ακόμη και κατηγορία εκτός πρώτης σελίδας.
                    IReadOnlyList<CatalogCategoryOption>? options =
                        await Manager.SearchCategoriesAsync(userId,
                            _workspace.Tenant.TenantId, null, categoryId,
                            context.RequestAborted);
                    if (options is not null)
                    {
                        _details = _details with { Categories = options };
                    }
                }
            }
        }
        catch (OperationCanceledException) when (context.RequestAborted.IsCancellationRequested)
        {
            throw;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Catalog manage page failed");
            _error = true;
        }
    }
}
