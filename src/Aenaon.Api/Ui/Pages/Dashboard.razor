@page "/dashboard"
@attribute [Authorize]
@layout MainLayout
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject TenantWorkspaceResolver WorkspaceResolver
@inject ILogger<Dashboard> Logger

<PageTitle>Επισκόπηση | Aenaon ERP</PageTitle>

<main class="dashboard">
    <aside class="sidebar">
        <a class="sidebar__brand" href="/dashboard" aria-label="Aenaon ERP — Επισκόπηση">
            <div class="sidebar__logo">
                <img src="/images/aenaon-favicon.png" alt="" width="48" height="48" />
            </div>
            <div class="sidebar__brand-text">
                <strong>AENAON</strong><span>ERP · MOONHARD</span>
            </div>
        </a>

        <div class="sidebar__section-title">ΠΛΟΗΓΗΣΗ</div>
        <nav class="sidebar__nav" aria-label="Κύρια πλοήγηση">
            <a class="sidebar__link sidebar__link--active" href="/dashboard" aria-current="page">
                <AppIcon Name="overview" /> Επισκόπηση
            </a>
            <span class="sidebar__link sidebar__link--disabled">
                <AppIcon Name="sales" /> Εμπορική διαχείριση <small>Σύντομα</small>
            </span>
            <span class="sidebar__link sidebar__link--disabled">
                <AppIcon Name="warehouse" /> Αποθήκη <small>Σύντομα</small>
            </span>
            <span class="sidebar__link sidebar__link--disabled">
                <AppIcon Name="settings" /> Ρυθμίσεις <small>Σύντομα</small>
            </span>
        </nav>
        <div class="sidebar__foot">
            <span class="sidebar__status-dot"></span> ΠΕΡΙΒΑΛΛΟΝ ΑΝΑΠΤΥΞΗΣ
            <span class="sidebar__version">Aenaon ERP · Build @UiAppInfo.Version</span>
        </div>
    </aside>

    <div class="dashboard__content">
        <header class="topbar">
            <div class="breadcrumb">Εφαρμογή <span>/</span> <strong>Επισκόπηση</strong></div>
            <div class="topbar__actions">
                <button type="button" class="theme-toggle" data-theme-toggle aria-label="Εναλλαγή θέματος">
                    <AppIcon Name="sun-moon" /> <span data-theme-label>Θέμα</span>
                </button>
                <div class="topbar__avatar" aria-label="Συνδεδεμένος χρήστης">@_initials</div>
                <span class="topbar__username">@_userName</span>
            </div>
        </header>

        <div class="dashboard__body">
            <div class="dashboard__heading">
                <div>
                    <p class="eyebrow eyebrow--green">ΚΕΝΤΡΙΚΗ ΕΠΙΣΚΟΠΗΣΗ</p>
                    <h1>Καλώς ήρθατε, @_userName.</h1>
                    <p>Διαχειριστείτε με ασφάλεια τις επιχειρήσεις και τα καταστήματά σας.</p>
                </div>
                @if (!string.IsNullOrWhiteSpace(_csrfToken))
                {
                    <form method="post" action="/ui/session/logout" class="logout-form">
                        <input type="hidden" name="__RequestVerificationToken" value="@_csrfToken" />
                        <button class="button button--outline" type="submit">
                            <AppIcon Name="logout" /> Αποσύνδεση
                        </button>
                    </form>
                }
            </div>

            @if (_error)
            {
                <div class="form-alert" role="alert">
                    Η ανάκτηση δεδομένων δεν ολοκληρώθηκε. Ανανεώστε τη σελίδα και ελέγξτε τη σύνδεση με τη βάση.
                </div>
            }
            else if (_workspace is not null)
            {
                @if (_workspace.Status is TenantWorkspaceStatus.InvalidTenant)
                {
                    <div class="workspace-alert" role="alert">
                        Η επιλεγμένη επιχείρηση δεν είναι διαθέσιμη στον λογαριασμό σας.
                        Επιλέξτε μία από τις επιχειρήσεις σας παρακάτω.
                    </div>
                }
                else if (_workspace.Status is TenantWorkspaceStatus.InvalidStore)
                {
                    <div class="workspace-alert" role="alert">
                        Το επιλεγμένο κατάστημα δεν είναι διαθέσιμο στην επιχείρησή σας.
                        Επιλέξτε ένα από τα επιτρεπόμενα καταστήματα.
                    </div>
                }
                else if (_workspace.Status is TenantWorkspaceStatus.NoTenants)
                {
                    <div class="workspace-alert" role="status">
                        Δεν έχει ανατεθεί επιχείρηση στον λογαριασμό σας.
                    </div>
                }
                else if (_workspace.Status is TenantWorkspaceStatus.NoStores)
                {
                    <div class="workspace-alert" role="status">
                        Η επιχείρηση δεν διαθέτει καταχωρημένα καταστήματα.
                    </div>
                }

                @if (_workspace.Status is TenantWorkspaceStatus.Ready)
                {
                    <section class="active-workspace" aria-label="Ενεργό πλαίσιο εργασίας">
                        <span class="active-workspace__icon"><AppIcon Name="check" /></span>
                        <div class="active-workspace__details">
                            <span>ΕΝΕΡΓΟ ΠΛΑΙΣΙΟ ΕΡΓΑΣΙΑΣ</span>
                            <strong>@_workspace.Tenant?.Name / @_workspace.Store?.Name</strong>
                            <small>Κωδικός καταστήματος: @_workspace.Store?.Code</small>
                        </div>
                        <span class="active-workspace__status">Επιβεβαιωμένη πρόσβαση</span>
                    </section>
                }

                <section class="workspace-overview" aria-label="Σύνοψη πρόσβασης">
                    <div class="stat-card">
                        <div class="stat-card__label">Επιχειρήσεις <AppIcon Name="building" /></div>
                        <div class="stat-card__value">@_workspace.Tenants.Count</div>
                        <div class="stat-card__caption">στις οποίες έχετε πρόσβαση</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-card__label">Καταστήματα <AppIcon Name="store" /></div>
                        <div class="stat-card__value">@_workspace.Stores.Count</div>
                        <div class="stat-card__caption">στην επιλεγμένη επιχείρηση</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-card__label">Σύνδεση <AppIcon Name="shield" /></div>
                        <div class="stat-card__value stat-card__value--status"><span class="status-dot"></span> Ενεργή</div>
                        <div class="stat-card__caption">Επαληθευμένη ταυτότητα χρήστη</div>
                    </div>
                </section>

                <div class="workspace-grid">
                    <section class="surface-card">
                        <div class="surface-card__heading">
                            <div>
                                <p class="eyebrow eyebrow--green">ΕΠΙΧΕΙΡΗΣΕΙΣ</p>
                                <h2>Οι επιχειρήσεις μου</h2>
                            </div>
                            <span class="count-pill">@_workspace.Tenants.Count</span>
                        </div>
                        @if (_workspace.Tenants.Count == 0)
                        {
                            <p class="empty-state">Δεν βρέθηκαν επιχειρήσεις για τον λογαριασμό.</p>
                        }
                        else
                        {
                            <div class="tenant-list">
                                @foreach (var tenant in _workspace.Tenants)
                                {
                                    bool selected = tenant.TenantId == _workspace.Tenant?.TenantId;
                                    <a class="tenant-entry @(selected ? "tenant-entry--active" : "")"
                                       href="@($"/dashboard?tenantId={tenant.TenantId:D}")"
                                       aria-current="@(selected ? "location" : null)">
                                        <span class="tenant-entry__icon"><AppIcon Name="building" /></span>
                                        <span class="tenant-entry__details">
                                            <strong>@tenant.Name</strong>
                                            <small>@(tenant.Role == Aenaon.Domain.Tenancy.TenantMembershipRole.Owner
                                                ? "Διαχειριστής επιχείρησης" : "Μέλος επιχείρησης")</small>
                                        </span>
                                        <span class="tenant-entry__chevron"><AppIcon Name="chevron" /></span>
                                    </a>
                                }
                            </div>
                        }
                    </section>

                    <section class="surface-card">
                        <div class="surface-card__heading">
                            <div>
                                <p class="eyebrow eyebrow--green">ΚΑΤΑΣΤΗΜΑΤΑ</p>
                                <h2>@(_workspace.Tenant?.Name ?? "Επιλογή επιχείρησης")</h2>
                            </div>
                            <span class="count-pill">@_workspace.Stores.Count</span>
                        </div>
                        @if (_workspace.Stores.Count == 0)
                        {
                            <p class="empty-state">Δεν υπάρχουν διαθέσιμα καταστήματα.</p>
                        }
                        else
                        {
                            <p class="store-selector__help">Επιλέξτε το κατάστημα στο οποίο θέλετε να εργαστείτε.</p>
                            <div class="stores-list">
                                @foreach (var store in _workspace.Stores)
                                {
                                    bool selected = store.StoreId == _workspace.Store?.StoreId;
                                    <a class="store-entry @(selected ? "store-entry--active" : "")"
                                       href="@($"/dashboard?tenantId={store.TenantId:D}&storeId={store.StoreId:D}")"
                                       aria-current="@(selected ? "location" : null)">
                                        <span class="store-entry__icon"><AppIcon Name="store" /></span>
                                        <span class="store-entry__details">
                                            <strong>@store.Name</strong>
                                            <small>Κωδικός: @store.Code</small>
                                        </span>
                                        <span class="store-entry__badge">@(selected ? "Επιλεγμένο" : "Επιλογή")</span>
                                    </a>
                                }
                            </div>
                        }
                    </section>
                </div>

                <section class="next-steps">
                    <span class="next-steps__symbol"><AppIcon Name="overview" /></span>
                    <div>
                        <strong>Το επόμενο κεφάλαιο του Aenaon ERP</strong>
                        <p>Οι λειτουργίες πωλήσεων, αποθήκης και αναφορών θα προστεθούν σε επόμενα στάδια ανάπτυξης.</p>
                    </div>
                </section>
            }
        </div>
        <footer class="dashboard__footer">
            © @DateTime.UtcNow.Year Aenaon ERP · by MoonHard
            <span>Built with .NET &amp; Blazor</span>
        </footer>
    </div>
</main>

@code {
    [SupplyParameterFromQuery(Name = "tenantId")]
    public Guid? TenantId { get; set; }

    [SupplyParameterFromQuery(Name = "storeId")]
    public Guid? StoreId { get; set; }

    private TenantWorkspaceSnapshot? _workspace;
    private string _userName = "Χρήστης";
    private string _initials = "A";
    private string? _csrfToken;
    private bool _error;

    protected override async Task OnParametersSetAsync()
    {
        var context = HttpContextAccessor.HttpContext;
        if (context?.Request.IsHttps != true ||
            context.User.Identity?.IsAuthenticated != true ||
            !Guid.TryParse(context.User.FindFirstValue(ClaimTypes.NameIdentifier), out Guid userId))
        {
            return;
        }

        _userName = context.User.Identity.Name ?? "Χρήστης";
        _initials = _userName.Length > 0 ? _userName[..1].ToUpperInvariant() : "A";
        _csrfToken = Antiforgery.GetAndStoreTokens(context).RequestToken;
        context.Response.Headers.CacheControl = "no-store";
        _error = false;

        try
        {
            _workspace = await WorkspaceResolver.ResolveAsync(
                userId, TenantId, StoreId, context.RequestAborted);
        }
        catch (OperationCanceledException) when (context.RequestAborted.IsCancellationRequested)
        {
            throw;
        }
        catch (Exception exception)
        {
            // Αποκρύπτουμε τεχνικές λεπτομέρειες βάσης, χωρίς να εμφανίζουμε παρωχημένα στοιχεία.
            Logger.LogError(exception, "Dashboard workspace resolution failed");
            _workspace = null;
            _error = true;
        }
    }
}
