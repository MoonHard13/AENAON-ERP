@page "/dashboard"
@attribute [Authorize]
@layout MainLayout
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject TenantWorkspaceResolver WorkspaceResolver
@inject WorkspacePreferenceService Preference
@inject ILogger<Dashboard> Logger

<PageTitle>Επισκόπηση | Aenaon ERP</PageTitle>

<main class="dashboard">
    <BackOfficeSidebar ActivePage="dashboard" TenantId="@TenantId" StoreId="@StoreId" />

    <div class="dashboard__content">
        <BackOfficeTopbar ActivePage="dashboard" PageTitle="Επισκόπηση"
                          UserName="@_userName"
                          Workspace="@_workspace"
                          CsrfToken="@_csrfToken" TenantId="@TenantId" StoreId="@StoreId" />

        <div class="dashboard__body">
            <div class="dashboard__heading">
                <div>
                    <p class="eyebrow eyebrow--green">ΚΕΝΤΡΙΚΗ ΕΠΙΣΚΟΠΗΣΗ</p>
                    <h1>Καλώς ήρθατε, @_userName.</h1>
                    <p>Επιλέξτε επιχείρηση και κατάστημα για να εργαστείτε.</p>
                </div>

            </div>

            @if (_error)
            {
                <div class="form-alert" role="alert">
                    Η ανάκτηση δεδομένων δεν ολοκληρώθηκε. Ανανεώστε τη σελίδα και ελέγξτε τη σύνδεση με τη βάση.
                </div>
            }
            else if (_workspace is not null)
            {
                @if (_workspace.Status is TenantWorkspaceStatus.InvalidTenant)
                {
                    <div class="workspace-alert" role="alert">
                        Η επιλεγμένη επιχείρηση δεν είναι διαθέσιμη στον λογαριασμό σας.
                        Επιλέξτε μία από τις επιχειρήσεις σας παρακάτω.
                    </div>
                }
                else if (_workspace.Status is TenantWorkspaceStatus.InvalidStore)
                {
                    <div class="workspace-alert" role="alert">
                        Το επιλεγμένο κατάστημα δεν είναι διαθέσιμο στην επιχείρησή σας.
                        Επιλέξτε ένα από τα επιτρεπόμενα καταστήματα.
                    </div>
                }
                else if (_workspace.Status is TenantWorkspaceStatus.NoTenants)
                {
                    <div class="workspace-alert" role="status">
                        Δεν έχει ανατεθεί επιχείρηση στον λογαριασμό σας.
                    </div>
                }
                else if (_workspace.Status is TenantWorkspaceStatus.NoStores)
                {
                    <div class="workspace-alert" role="status">
                        Η επιχείρηση δεν διαθέτει καταχωρημένα καταστήματα.
                    </div>
                }

                <section class="workspace-selection" id="workspace-selection"
                         aria-labelledby="workspace-selection-title">
                    <div class="workspace-selection__header">
                        <div>
                            <p class="eyebrow eyebrow--green">ΕΠΙΛΟΓΗ ΠΛΑΙΣΙΟΥ</p>
                            <h2 id="workspace-selection-title">Επιχείρηση &amp; κατάστημα</h2>
                            <p>Η επιλογή σας ισχύει για τις διαθέσιμες λειτουργίες του Back Office.</p>
                        </div>
                        <span class="workspace-selection__counts">
                            @_workspace.Tenants.Count επιχειρήσεις · @_workspace.Stores.Count καταστήματα
                        </span>
                    </div>
                <div class="workspace-grid">
                    <section class="surface-card">
                        <div class="surface-card__heading">
                            <div>
                                <p class="eyebrow eyebrow--green">ΕΠΙΧΕΙΡΗΣΕΙΣ</p>
                                <h2>Οι επιχειρήσεις μου</h2>
                            </div>
                            <span class="count-pill">@_workspace.Tenants.Count</span>
                        </div>
                        @if (_workspace.Tenants.Count == 0)
                        {
                            <p class="empty-state">Δεν βρέθηκαν επιχειρήσεις για τον λογαριασμό.</p>
                        }
                        else
                        {
                            <div class="tenant-list">
                                @foreach (var tenant in _workspace.Tenants)
                                {
                                    bool selected = tenant.TenantId == _workspace.Tenant?.TenantId;
                                    <form method="post" action="/ui/workspace/select" class="workspace-choice-form">
                                        <input type="hidden" name="__RequestVerificationToken" value="@_csrfToken" />
                                        <input type="hidden" name="tenantId" value="@tenant.TenantId" />
                                        <button type="submit" class="tenant-entry @(selected ? "tenant-entry--active" : "")"
                                                aria-current="@(selected ? "location" : null)">
                                        <span class="tenant-entry__icon"><AppIcon Name="building" /></span>
                                        <span class="tenant-entry__details">
                                            <strong>@tenant.Name</strong>
                                            <small>@(tenant.Role == Aenaon.Domain.Tenancy.TenantMembershipRole.Owner
                                                ? "Διαχειριστής επιχείρησης" : "Μέλος επιχείρησης")</small>
                                        </span>
                                        <span class="tenant-entry__chevron"><AppIcon Name="chevron" /></span>
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                    </section>

                    <section class="surface-card">
                        <div class="surface-card__heading">
                            <div>
                                <p class="eyebrow eyebrow--green">ΚΑΤΑΣΤΗΜΑΤΑ</p>
                                <h2>Τα καταστήματά μου</h2>
                            </div>
                            <span class="count-pill">@_workspace.Stores.Count</span>
                        </div>
                        @if (_workspace.Stores.Count == 0)
                        {
                            <p class="empty-state">Δεν υπάρχουν διαθέσιμα καταστήματα.</p>
                        }
                        else
                        {
                            <p class="store-selector__help">Επιλέξτε το κατάστημα στο οποίο θέλετε να εργαστείτε.</p>
                            <div class="stores-list">
                                @foreach (var store in _workspace.Stores)
                                {
                                    bool selected = store.StoreId == _workspace.Store?.StoreId;
                                    <form method="post" action="/ui/workspace/select" class="workspace-choice-form">
                                        <input type="hidden" name="__RequestVerificationToken" value="@_csrfToken" />
                                        <input type="hidden" name="tenantId" value="@store.TenantId" />
                                        <input type="hidden" name="storeId" value="@store.StoreId" />
                                        <button type="submit" class="store-entry @(selected ? "store-entry--active" : "")"
                                                aria-current="@(selected ? "location" : null)">
                                        <span class="store-entry__icon"><AppIcon Name="store" /></span>
                                        <span class="store-entry__details">
                                            <strong>@store.Name</strong>
                                            <small>Κωδικός: @store.Code</small>
                                        </span>
                                        <span class="store-entry__badge">@(selected ? "Επιλεγμένο" : "Επιλογή")</span>
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                    </section>
                </div>

                </section>

                <section class="next-steps">
                    <span class="next-steps__symbol"><AppIcon Name="overview" /></span>
                    <div>
                        <strong>Κατάλογος προϊόντων &amp; υπηρεσιών</strong>
                        <p>Προβάλετε τις κατηγορίες, τα προϊόντα και τις υπηρεσίες της επιχείρησης.</p>
                    </div>
                    <a class="button button--outline next-steps__link" href="/catalog">
                        Άνοιγμα καταλόγου <AppIcon Name="arrow" />
                    </a>
                </section>
            }
        </div>
        <footer class="dashboard__footer">
            © @DateTime.UtcNow.Year Aenaon ERP · by MoonHard
            <span>Built with .NET &amp; Blazor</span>
        </footer>
    </div>
</main>

@code {
    [SupplyParameterFromQuery(Name = "tenantId")]
    public Guid? TenantId { get; set; }

    [SupplyParameterFromQuery(Name = "storeId")]
    public Guid? StoreId { get; set; }

    private TenantWorkspaceSnapshot? _workspace;
    private string _userName = "Χρήστης";
    private string? _csrfToken;
    private bool _error;

    protected override async Task OnParametersSetAsync()
    {
        var context = HttpContextAccessor.HttpContext;
        if (context?.Request.IsHttps != true ||
            context.User.Identity?.IsAuthenticated != true ||
            !Guid.TryParse(context.User.FindFirstValue(ClaimTypes.NameIdentifier), out Guid userId))
        {
            return;
        }

        _userName = context.User.Identity.Name ?? "Χρήστης";
        _csrfToken = Antiforgery.GetAndStoreTokens(context).RequestToken;
        context.Response.Headers.CacheControl = "no-store";
        _error = false;

        try
        {
            Guid? selectedTenantId = TenantId;
            Guid? selectedStoreId = StoreId;

            // Το cookie επιλογής χρησιμοποιείται μόνο όταν δεν υπάρχει ρητή επιλογή στο URL.
            if (!TenantId.HasValue && !StoreId.HasValue &&
                Preference.TryRead(context, userId, out Guid preferredTenantId, out Guid? preferredStoreId))
            {
                selectedTenantId = preferredTenantId;
                selectedStoreId = preferredStoreId;
            }

            _workspace = await WorkspaceResolver.ResolveAsync(
                userId, selectedTenantId, selectedStoreId, context.RequestAborted);
        }
        catch (OperationCanceledException) when (context.RequestAborted.IsCancellationRequested)
        {
            throw;
        }
        catch (Exception exception)
        {
            // Αποκρύπτουμε τεχνικές λεπτομέρειες βάσης, χωρίς να εμφανίζουμε παρωχημένα στοιχεία.
            Logger.LogError(exception, "Dashboard workspace resolution failed");
            _workspace = null;
            _error = true;
        }
    }
}
