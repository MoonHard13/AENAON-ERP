@page "/login"
@layout MainLayout
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Σύνδεση | Aenaon ERP</PageTitle>

<main class="login-page">
    <section class="login-presentation" aria-label="Aenaon ERP">
        <div class="presentation__top">
            <span class="presentation__dot"></span>
            <span>AENAON ERP <span class="presentation__muted">/ BY MOONHARD</span></span>
        </div>
        <div class="presentation__content">
            <div class="presentation__logo">
                <img src="/images/aenaon-logo-dark.webp" alt="Aenaon ERP by MoonHard" width="390" height="390" />
            </div>
            <div class="presentation__copy">
                <span class="eyebrow">THE NEXT GENERATION ERP</span>
                <h2>Η επιχείρησή σας.<br />Στο επόμενο επίπεδο.</h2>
                <p>Ενιαία εικόνα. Ασφαλής διαχείριση. Απεριόριστες δυνατότητες.</p>
            </div>
        </div>
        <div class="presentation__bottom"><span>Σχεδιασμένο για την επιχείρηση του αύριο</span><span>© @DateTime.UtcNow.Year MoonHard</span></div>
    </section>

    <section class="login-form-panel">
        <div class="login-panel__toolbar">
            <span class="environment-pill">DEVELOPMENT</span>
            <button type="button" class="theme-toggle" data-theme-toggle aria-label="Εναλλαγή φωτεινού και σκούρου θέματος">
                <AppIcon Name="sun-moon" /> <span data-theme-label>Θέμα</span>
            </button>
        </div>
        <div class="login-panel__content">
            <div class="login-mobile-brand"><img class="logo-for-light" src="/images/aenaon-logo-light.webp" alt="Aenaon ERP" width="180" height="180" /><img class="logo-for-dark" src="/images/aenaon-logo-dark.webp" alt="Aenaon ERP" width="180" height="180" /></div>
            <div class="login-panel__headline">
                <span class="eyebrow eyebrow--green">ΚΑΛΩΣ ΗΡΘΑΤΕ</span>
                <h1>Σύνδεση στο Aenaon</h1>
                <p>Εισάγετε τα στοιχεία σας για να συνεχίσετε.</p>
            </div>
            @if (Error == "invalid")
            {
                <div class="form-alert" role="alert">Η σύνδεση δεν ολοκληρώθηκε. Ελέγξτε τα στοιχεία σας και δοκιμάστε ξανά.</div>
            }
            else if (Error == "rate-limited")
            {
                <div class="form-alert" role="alert">Έγιναν πολλές προσπάθειες σύνδεσης. Δοκιμάστε ξανά σε περίπου ένα λεπτό.</div>
            }
            @if (HttpContextAccessor.HttpContext?.User.Identity?.IsAuthenticated == true)
            {
                <div class="already-signed-in">
                    Είστε ήδη συνδεδεμένος.
                    <a href="/dashboard">Μετάβαση στο Dashboard</a>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_csrfToken))
            {
                <form method="post" action="/ui/session/login" class="login-form" autocomplete="on">
                    <input type="hidden" name="__RequestVerificationToken" value="@_csrfToken" />
                    <div class="field">
                        <label for="login-username">Όνομα χρήστη</label>
                        <input id="login-username" name="username" type="text" autocomplete="username"
                               placeholder="Εισάγετε το όνομα χρήστη" minlength="1" maxlength="128" autocapitalize="none" spellcheck="false" required autofocus />
                    </div>
                    <div class="field">
                        <div class="field__label-row"><label for="login-password">Κωδικός πρόσβασης</label></div>
                        <div class="password-field">
                            <input id="login-password" name="password" type="password" autocomplete="current-password"
                                   placeholder="Εισάγετε τον κωδικό σας" minlength="1" maxlength="1024" required />
                            <button type="button" class="password-field__toggle" data-password-toggle aria-controls="login-password"
                                    aria-label="Εμφάνιση κωδικού">Εμφάνιση</button>
                        </div>
                    </div>
                    <button class="button button--primary button--full" type="submit">Σύνδεση <AppIcon Name="arrow" /></button>
                </form>
            }
            else
            {
                <div class="form-alert" role="alert">Απαιτείται ασφαλής σύνδεση HTTPS.</div>
            }
            <p class="login-panel__footnote"><span aria-hidden="true">●</span> Ασφαλής σύνδεση με προστασία δεδομένων</p>
        </div>
        <div class="login-panel__footer"><span>Aenaon ERP · by MoonHard</span><span>Build @UiAppInfo.Version · Development</span></div>
    </section>
</main>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private string? _csrfToken;

    protected override void OnInitialized()
    {
        var context = HttpContextAccessor.HttpContext;
        if (context?.Request.IsHttps == true)
        {
            _csrfToken = Antiforgery.GetAndStoreTokens(context).RequestToken;
            context.Response.Headers.CacheControl = "no-store";
        }
    }
}
