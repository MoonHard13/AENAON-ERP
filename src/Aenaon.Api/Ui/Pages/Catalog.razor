@page "/catalog"
@attribute [Authorize]
@attribute [StreamRendering]
@layout MainLayout
@using Aenaon.Application.Catalog
@using Aenaon.Domain.Catalog
@using Aenaon.Domain.Tenancy
@using Aenaon.Domain.Exceptions
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject TenantWorkspaceResolver WorkspaceResolver
@inject WorkspacePreferenceService Preference
@inject CatalogReadService CatalogReader
@inject ILogger<Catalog> Logger

<PageTitle>Κατάλογος | Aenaon ERP</PageTitle>

<main class="dashboard">
    <BackOfficeSidebar ActivePage="catalog" TenantId="@TenantId" StoreId="@StoreId" />
    <div class="dashboard__content">
        <BackOfficeTopbar ActivePage="catalog" PageTitle="Κατάλογος"
                          UserName="@_userName"
                          Workspace="@_workspace"
                          CsrfToken="@_csrfToken" TenantId="@TenantId" StoreId="@StoreId" />

        <div class="dashboard__body catalog-page">
            @if (_loading)
            {
                <section class="surface-card catalog-loading" aria-busy="true" role="status">
                    <span class="catalog-loading__indicator" aria-hidden="true"></span>
                    <span>Φόρτωση καταλόγου και επαλήθευση πρόσβασης…</span>
                </section>
            }
            else if (_workspace is null || _errorCode is "database")
            {
                <div class="form-alert" role="alert">
                    Δεν ήταν δυνατή η φόρτωση του καταλόγου. Ελέγξτε τη σύνδεση και δοκιμάστε ξανά.
                </div>
            }
            else if (_workspace.Status is TenantWorkspaceStatus.InvalidTenant)
            {
                <div class="workspace-alert" role="alert">
                    Η επιλεγμένη επιχείρηση δεν είναι διαθέσιμη στον λογαριασμό σας.
                </div>
                <a class="button button--outline" href="/dashboard">Επιλογή επιχείρησης</a>
            }
            else if (_workspace.Status is TenantWorkspaceStatus.InvalidStore)
            {
                <div class="workspace-alert" role="alert">
                    Το επιλεγμένο κατάστημα δεν είναι διαθέσιμο στην επιχείρησή σας.
                </div>
                <a class="button button--outline" href="/dashboard">Επιλογή καταστήματος</a>
            }
            else if (_workspace.Status is TenantWorkspaceStatus.NoTenants)
            {
                <div class="workspace-alert" role="status">
                    Δεν υπάρχει επιχείρηση με δικαίωμα πρόσβασης για τον λογαριασμό σας.
                </div>
                <a class="button button--outline" href="/dashboard">Πίσω στην επισκόπηση</a>
            }
            else if (_workspace is { Tenant: not null })
            {
                @if (Saved == 1)
                {
                    <div class="catalog-success" role="status">
                        <AppIcon Name="check" /> Η καταχώρηση @SavedCode αποθηκεύτηκε επιτυχώς.
                    </div>
                }

                @if (SelectedView == "categories" && ParentId.HasValue)
                {
                    <div class="catalog-managed-note">
                        <AppIcon Name="folder-tree" /> Προβολή υποκατηγοριών
                        <a class="catalog-edit-link" href="@BuildUrl("categories", 1, reset: true, clearParent: true)">
                            Όλες οι κατηγορίες
                        </a>
                    </div>
                }

                <nav class="catalog-tabs" aria-label="Ενότητες καταλόγου">
                    <a class="@TabClass("products")" href="@BuildUrl("products", 1)"
                       aria-current="@(SelectedView == "products" ? "page" : null)">
                        <AppIcon Name="catalog" /> Προϊόντα
                    </a>
                    <a class="@TabClass("services")" href="@BuildUrl("services", 1)"
                       aria-current="@(SelectedView == "services" ? "page" : null)">
                        <AppIcon Name="sales" /> Υπηρεσίες
                    </a>
                    <a class="@TabClass("categories")" href="@BuildUrl("categories", 1)"
                       aria-current="@(SelectedView == "categories" ? "page" : null)">
                        <AppIcon Name="warehouse" /> Κατηγορίες
                    </a>
                </nav>

                <section class="surface-card catalog-surface" aria-labelledby="catalog-list-title">
                    <div class="catalog-surface__header">
                        <div class="catalog-surface__identity">
                            <h1 id="catalog-list-title">@SelectedTitle</h1>
                            @if (_errorCode is null && CurrentRows > 0)
                            {
                                <span class="count-pill">@CurrentRows εγγραφές στη σελίδα</span>
                            }
                        </div>
                        <div class="catalog-surface__actions">
                            @if (CanManage)
                            {
                                <a class="button button--primary catalog-create" href="@BuildManageUrl(SelectedView)">
                                    <AppIcon Name="plus" /> @NewButtonText
                                </a>
                            }
                            else
                            {
                                <span class="catalog-readonly"><AppIcon Name="shield" /> Μόνο ανάγνωση</span>
                            }
                        </div>
                    </div>

                    <form class="catalog-filters" method="get" action="/catalog" role="search"
                          aria-label="Αναζήτηση και φίλτρα καταλόγου">
                        <input type="hidden" name="view" value="@SelectedView" />
                        <input type="hidden" name="sort" value="@CurrentSort" />
                        @if (CurrentDescending)
                        {
                            <input type="hidden" name="desc" value="true" />
                        }
                        @if (TenantId.HasValue)
                        {
                            <input type="hidden" name="tenantId" value="@TenantId.Value" />
                        }
                        @if (StoreId.HasValue)
                        {
                            <input type="hidden" name="storeId" value="@StoreId.Value" />
                        }
                        <div class="catalog-field catalog-field--search">
                            <label for="catalog-search">Κωδικός, barcode ή περιγραφή (αρχίζει από)</label>
                            <div class="catalog-search">
                                <AppIcon Name="search" />
                                <input id="catalog-search" name="search" type="search"
                                       value="@Search" maxlength="80" autocomplete="off"
                                       placeholder="Αναζήτηση με πρόθεμα…" />
                            </div>
                        </div>
                        <div class="catalog-field catalog-field--size">
                            <label for="catalog-page-size">Εγγραφές</label>
                            <select id="catalog-page-size" name="pageSize">
                                <option value="25" selected="@(PageSize is null or 25)">25</option>
                                <option value="50" selected="@(PageSize == 50)">50</option>
                                <option value="100" selected="@(PageSize == 100)">100</option>
                            </select>
                        </div>
                        <label class="catalog-checkbox">
                            <input type="checkbox" name="inactive" value="true"
                                   checked="@(IncludeInactive == true)" />
                            Εμφάνιση ανενεργών
                        </label>
                        <button class="button button--primary catalog-filter-button" type="submit">
                            <AppIcon Name="search" /> Αναζήτηση
                        </button>
                        <a class="catalog-reset" href="@BuildResetUrl()" aria-label="Καθαρισμός φίλτρων">
                            Καθαρισμός
                        </a>
                    </form>

                    @if (_errorCode == "query")
                    {
                        <div class="form-alert" role="alert">
                            Μη έγκυρα φίλτρα. Επιτρέπονται σελίδες 1–1000, μεγέθη 25/50/100
                            και αναζήτηση έως 80 χαρακτήρες.
                        </div>
                    }
                    else if (_errorCode == "access")
                    {
                        <div class="workspace-alert" role="alert">
                            Δεν επιτρέπεται η προβολή του καταλόγου για αυτήν την επιχείρηση.
                        </div>
                    }
                    else if (_categories?.Rows.Count > 0)
                    {
                        <div class="catalog-table-wrap" tabindex="0" role="region"
                             aria-label="Πίνακας κατηγοριών με οριζόντια κύλιση">
                            <table class="catalog-table">
                                <thead>
                                    <tr>
                                        <CatalogSortHeader Label="Κωδικός" Href="@SortHref("code")"
                                                           Active="@(CurrentSort == "code")" Descending="@CurrentDescending" />
                                        <CatalogSortHeader Label="Κατηγορία" Href="@SortHref("name")"
                                                           Active="@(CurrentSort == "name")" Descending="@CurrentDescending" />
                                        <CatalogSortHeader Label="Κατάσταση" Href="@SortHref("status")"
                                                           Active="@(CurrentSort == "status")" Descending="@CurrentDescending" />
                                        <th scope="col">Ενέργειες</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (CatalogCategorySummary row in _categories.Rows)
                                    {
                                        <tr>
                                            <td><span class="catalog-code">@row.Code</span></td>
                                            <td class="catalog-table__name">
                                                @if (row.ParentCategoryId.HasValue)
                                                {
                                                    <span class="catalog-tree-parent" aria-label="Υποκατηγορία">↳</span>
                                                }
                                                <strong>@row.Name</strong>
                                                @if (!string.IsNullOrWhiteSpace(row.CategoryPath) && row.ParentCategoryId.HasValue)
                                                {
                                                    <small class="catalog-tree-path">@row.CategoryPath</small>
                                                }
                                                @if (row.HasChildren)
                                                {
                                                    <button type="button" class="catalog-tree-toggle"
                                                            data-category-branch="@row.Id"
                                                            data-tenant-id="@_workspace.Tenant.TenantId"
                                                            aria-expanded="false"
                                                            aria-controls="subtree-@row.Id">
                                                        <AppIcon Name="chevron" /> Ανάπτυξη υποκατηγοριών
                                                    </button>
                                                    <div id="subtree-@row.Id" class="catalog-tree-children"
                                                         hidden aria-live="polite"></div>
                                                }
                                            </td>
                                            <td><span class="@StatusClass(row.IsActive)">
                                                @(row.IsActive ? "Ενεργή" : "Ανενεργή")
                                            </span></td>
                                            @if (CanManage)
                                            {
                                                <td>
                                                    <div class="catalog-table-actions">
                                                        <a class="catalog-edit-link" href="@BuildManageUrl("categories", row.Id)"
                                                           aria-label="Επεξεργασία κατηγορίας @row.Code">Επεξεργασία</a>
                                                        @if (row.HasChildren)
                                                        {
                                                            <a class="catalog-edit-link" href="@BuildUrl("categories", 1, parent: row.Id)"
                                                               aria-label="Υποκατηγορίες @row.Code">Υποκατηγορίες</a>
                                                        }
                                                    </div>
                                                </td>
                                            }
                                            else
                                            {
                                                <td>
                                                    @if (row.HasChildren)
                                                    {
                                                        <a class="catalog-edit-link"
                                                           href="@BuildUrl("categories", 1, parent: row.Id)">Υποκατηγορίες</a>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (_items?.Rows.Count > 0)
                    {
                        <div class="catalog-table-wrap" tabindex="0" role="region"
                             aria-label="Πίνακας ειδών με οριζόντια κύλιση">
                            <table class="catalog-table">
                                <thead>
                                    <tr>
                                        <CatalogSortHeader Label="Κωδικός" Href="@SortHref("code")"
                                                           Active="@(CurrentSort == "code")" Descending="@CurrentDescending" />
                                        <CatalogSortHeader Label="Περιγραφή" Href="@SortHref("name")"
                                                           Active="@(CurrentSort == "name")" Descending="@CurrentDescending" />
                                        <CatalogSortHeader Label="Barcode" Href="@SortHref("barcode")"
                                                           Active="@(CurrentSort == "barcode")" Descending="@CurrentDescending" />
                                        <CatalogSortHeader Label="Κατηγορία" Href="@SortHref("category")"
                                                           Active="@(CurrentSort == "category")" Descending="@CurrentDescending" />
                                        <CatalogSortHeader Label="Τύπος" Href="@SortHref("kind")"
                                                           Active="@(CurrentSort == "kind")" Descending="@CurrentDescending" />
                                        <CatalogSortHeader Label="Μονάδα" Href="@SortHref("unit")"
                                                           Active="@(CurrentSort == "unit")" Descending="@CurrentDescending" />
                                        <CatalogSortHeader Label="Λογιστικός τύπος" Href="@SortHref("accounting")"
                                                           Active="@(CurrentSort == "accounting")" Descending="@CurrentDescending" />
                                        <CatalogSortHeader Label="Απόθεμα" Href="@SortHref("stock")"
                                                           Active="@(CurrentSort == "stock")" Descending="@CurrentDescending" />
                                        <CatalogSortHeader Label="Κατάσταση" Href="@SortHref("status")"
                                                           Active="@(CurrentSort == "status")" Descending="@CurrentDescending" />
                                        @if (CanManage) { <th scope="col">Ενέργειες</th> }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (CatalogItemSummary row in _items.Rows)
                                    {
                                        <tr>
                                            <td><span class="catalog-code">@row.Code</span></td>
                                            <td class="catalog-table__name">@row.Name</td>
                                            <td><span class="catalog-code">@(row.Barcode ?? "—")</span></td>
                                            <td><span class="catalog-tree-path">@(row.CategoryPath ?? row.CategoryName ?? "—")</span></td>
                                            <td>@(row.Kind == CatalogItemKind.Service ? "Υπηρεσία" : "Προϊόν")</td>
                                            <td>@(row.UnitOfMeasure is { } unit
                                                ? CatalogCommercialOptions.UnitName(unit) : "—")</td>
                                            <td>@(row.AccountingType is { } accounting
                                                ? CatalogCommercialOptions.AccountingName(accounting) : "—")</td>
                                            <td>@(row.TracksStock ? "Ναι" : "Όχι")</td>
                                            <td><span class="@StatusClass(row.IsActive)">
                                                @(row.IsActive ? "Ενεργό" : "Ανενεργό")
                                            </span></td>
                                            @if (CanManage)
                                            {
                                                <td><a class="catalog-edit-link" href="@BuildManageUrl(SelectedView, row.Id)"
                                                       aria-label="Επεξεργασία είδους @row.Code">Επεξεργασία</a></td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="catalog-empty" role="status">
                            <span class="catalog-empty__icon"><AppIcon Name="search" /></span>
                            <strong>@EmptyTitle</strong>
                            <p>@EmptyDescription</p>
                        </div>
                    }

                    @if (_errorCode is null && (_categories is not null || _items is not null) && (HasMore || CurrentPage > 1))
                    {
                        <div class="catalog-pager" aria-label="Σελιδοποίηση">
                            <span>Σελίδα @CurrentPage · Έως @CurrentPageSize εγγραφές ανά σελίδα</span>
                            <div class="catalog-pager__actions">
                                @if (CurrentPage > 1)
                                {
                                    <a href="@BuildUrl(SelectedView, CurrentPage - 1)" rel="prev">Προηγούμενη</a>
                                }
                                else
                                {
                                    <span class="catalog-pager__disabled">Προηγούμενη</span>
                                }
                                @if (HasMore && CurrentPage < CatalogReadQuery.MaxPage)
                                {
                                    <a href="@BuildUrl(SelectedView, CurrentPage + 1)" rel="next">Επόμενη</a>
                                }
                                else
                                {
                                    <span class="catalog-pager__disabled">Επόμενη</span>
                                }
                            </div>
                        </div>
                    }
                </section>

                <p class="catalog-disclaimer">
                    @if (CanManage)
                    {
                        <span>Μπορείτε να δημιουργείτε και να επεξεργάζεστε κατηγορίες, προϊόντα και υπηρεσίες.</span>
                    }
                    else
                    {
                        <span>Η οθόνη είναι μόνο για ανάγνωση.</span>
                    }
                    Δεν ενημερώνονται τιμές, ΦΠΑ, υπόλοιπα αποθήκης ή φορολογικές ταξινομήσεις.
                </p>
            }
        </div>
        <footer class="dashboard__footer">
            © @DateTime.UtcNow.Year Aenaon ERP · by MoonHard
            <span>Built with .NET &amp; Blazor</span>
        </footer>
    </div>
</main>

@code {
    [SupplyParameterFromQuery(Name = "tenantId")]
    public Guid? TenantId { get; set; }

    [SupplyParameterFromQuery(Name = "storeId")]
    public Guid? StoreId { get; set; }

    [SupplyParameterFromQuery(Name = "view")]
    public string? View { get; set; }

    [SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? PageNumber { get; set; }

    [SupplyParameterFromQuery(Name = "pageSize")]
    public int? PageSize { get; set; }

    [SupplyParameterFromQuery(Name = "inactive")]
    public bool? IncludeInactive { get; set; }

    [SupplyParameterFromQuery(Name = "saved")]
    public int? Saved { get; set; }

    [SupplyParameterFromQuery(Name = "savedCode")]
    public string? SavedCode { get; set; }

    [SupplyParameterFromQuery(Name = "parentId")]
    public Guid? ParentId { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? SortBy { get; set; }

    [SupplyParameterFromQuery(Name = "desc")]
    public bool? Descending { get; set; }

    private TenantWorkspaceSnapshot? _workspace;
    private CatalogReadPage<CatalogCategorySummary>? _categories;
    private CatalogReadPage<CatalogItemSummary>? _items;
    private string _userName = "Χρήστης";
    private string? _csrfToken;
    private string? _errorCode;
    private bool _loading = true;

    private string SelectedView => string.IsNullOrEmpty(View) ? "products" : View;
    private string CurrentSort => string.IsNullOrEmpty(SortBy) ? "code" : SortBy;
    private bool CurrentDescending => Descending == true;
    private bool SortIsValidForView(string view, string key) =>
        key is "code" or "name" or "status" ||
        (view != "categories" && key is "category" or "kind" or "stock" or "unit" or "accounting" or "barcode");
    private string SortHref(string key) =>
        BuildUrl(SelectedView, 1, sort: key,
            descending: CurrentSort == key && !CurrentDescending);
    private bool CanManage => _workspace?.Tenant?.Role == TenantMembershipRole.Owner &&
        _workspace.Status is (TenantWorkspaceStatus.Ready or TenantWorkspaceStatus.NoStores);
    private string NewButtonText => SelectedView switch
    {
        "categories" => "Νέα κατηγορία",
        "services" => "Νέα υπηρεσία",
        _ => "Νέο προϊόν"
    };

    private string SelectedTitle => SelectedView switch
    {
        "categories" => "Κατηγορίες",
        "services" => "Υπηρεσίες",
        _ => "Προϊόντα"
    };
    private bool HasSearch => !string.IsNullOrWhiteSpace(Search);
    private string EmptyTitle => HasSearch
        ? $"Δεν βρέθηκαν {SelectedTitle.ToLowerInvariant()}."
        : SelectedView switch
        {
            "categories" => "Δεν υπάρχουν ακόμη κατηγορίες.",
            "services" => "Δεν υπάρχουν ακόμη υπηρεσίες.",
            _ => "Δεν υπάρχουν ακόμη προϊόντα."
        };
    private string EmptyDescription => HasSearch
        ? "Δοκιμάστε διαφορετικό πρόθεμα ή καθαρίστε τα φίλτρα αναζήτησης."
        : CanManage
            ? "Δεν υπάρχουν ακόμη καταχωρίσεις. Επιλέξτε «" + NewButtonText + "» για να ξεκινήσετε."
            : "Δεν υπάρχουν ακόμη καταχωρίσεις σε αυτήν την ενότητα.";

    private int CurrentRows => _categories?.Rows.Count ?? _items?.Rows.Count ?? 0;
    private int CurrentPage => _categories?.Page ?? _items?.Page ?? (PageNumber ?? 1);
    private int CurrentPageSize => _categories?.PageSize ?? _items?.PageSize ?? (PageSize ?? 25);
    private bool HasMore => _categories?.HasMore ?? _items?.HasMore ?? false;

    protected override async Task OnParametersSetAsync()
    {
        _workspace = null;
        _categories = null;
        _items = null;
        _errorCode = null;
        _loading = true;

        HttpContext? context = HttpContextAccessor.HttpContext;
        if (context?.Request.IsHttps != true ||
            context.User.Identity?.IsAuthenticated != true ||
            !Guid.TryParse(context.User.FindFirstValue(ClaimTypes.NameIdentifier), out Guid userId) ||
            userId == Guid.Empty)
        {
            _errorCode = "database";
            _loading = false;
            return;
        }

        _userName = context.User.Identity.Name ?? "Χρήστης";
        _csrfToken = Antiforgery.GetAndStoreTokens(context).RequestToken;
        context.Response.Headers.CacheControl = "no-store";

        try
        {
            Guid? requestedTenant = TenantId;
            Guid? requestedStore = StoreId;

            // Το κρυπτογραφημένο cookie χρησιμοποιείται μόνο χωρίς ρητή επιλογή URL.
            if (!TenantId.HasValue && !StoreId.HasValue &&
                Preference.TryRead(context, userId, out Guid preferredTenant, out Guid? preferredStore))
            {
                requestedTenant = preferredTenant;
                requestedStore = preferredStore;
            }

            _workspace = await WorkspaceResolver.ResolveAsync(
                userId, requestedTenant, requestedStore, context.RequestAborted);

            // Τα μη έγκυρα Tenants/Stores δεν οδηγούν ποτέ σε fallback ανάγνωση.
            if (_workspace.Status is not (TenantWorkspaceStatus.Ready or TenantWorkspaceStatus.NoStores))
            {
                return;
            }

            if (SelectedView is not ("products" or "services" or "categories") ||
                PageSize is not (null or 25 or 50 or 100))
            {
                _errorCode = "query";
                return;
            }

            CatalogItemKind? kind = SelectedView switch
            {
                "products" => CatalogItemKind.Product,
                "services" => CatalogItemKind.Service,
                _ => null
            };
            CatalogReadQuery query = new(
                PageNumber ?? 1, PageSize ?? 25, Search, IncludeInactive == true, kind,
                SelectedView == "categories" ? ParentId : null,
                CurrentSort, CurrentDescending);
            query = query.Validated();

            if (SelectedView == "categories")
            {
                CatalogReadResult<CatalogCategorySummary> result =
                    await CatalogReader.ReadCategoriesAsync(
                        userId, _workspace.Tenant!.TenantId, query, context.RequestAborted);
                _errorCode = result.IsAuthorized ? null : "access";
                _categories = result.Page;
            }
            else
            {
                CatalogReadResult<CatalogItemSummary> result =
                    await CatalogReader.ReadItemsAsync(
                        userId, _workspace.Tenant!.TenantId, query, context.RequestAborted);
                _errorCode = result.IsAuthorized ? null : "access";
                _items = result.Page;
            }

            if (_errorCode is null)
            {
                Logger.LogInformation(
                    "Catalog UI read for {UserId} {TenantId} {View} page {Page} size {PageSize} sort {SortBy} descending {Descending}",
                    userId, _workspace.Tenant!.TenantId, SelectedView, query.Page,
                    query.PageSize, query.SortBy, query.Descending);
            }
            else
            {
                Logger.LogWarning(
                    "Catalog UI access denied for {UserId} {TenantId}",
                    userId, _workspace.Tenant!.TenantId);
            }
        }
        catch (DomainRuleException)
        {
            _errorCode = "query";
        }
        catch (OperationCanceledException) when (context.RequestAborted.IsCancellationRequested)
        {
            throw;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Catalog UI load failed");
            _categories = null;
            _items = null;
            _errorCode = "database";
        }
        finally
        {
            _loading = false;
        }
    }

    private string TabClass(string view) =>
        SelectedView == view ? "catalog-tabs__link catalog-tabs__link--active" : "catalog-tabs__link";

    private static string StatusClass(bool active) =>
        active ? "catalog-status catalog-status--active" : "catalog-status catalog-status--inactive";

    private string BuildManageUrl(string view, Guid? id = null)
    {
        string url = $"/catalog/manage?view={Uri.EscapeDataString(view)}";
        if (_workspace?.Tenant is { } tenant)
        {
            url += $"&tenantId={tenant.TenantId:D}";
            if (_workspace.Store is { } store)
            {
                url += $"&storeId={store.StoreId:D}";
            }
        }

        return id.HasValue ? url + $"&id={id.Value:D}" : url;
    }

    private string BuildResetUrl() => BuildUrl(SelectedView, 1, reset: true);

    private string BuildUrl(string view, int page, bool reset = false,
        Guid? parent = null, bool clearParent = false,
        string? sort = null, bool? descending = null)
    {
        var parameters = new List<string>
        {
            $"view={Uri.EscapeDataString(view)}"
        };

        if (TenantId.HasValue)
        {
            parameters.Add($"tenantId={TenantId.Value:D}");
        }

        if (StoreId.HasValue)
        {
            parameters.Add($"storeId={StoreId.Value:D}");
        }

        if (!reset)
        {
            if (!string.IsNullOrWhiteSpace(Search) && Search.Length <= CatalogReadQuery.MaxSearchLength)
            {
                parameters.Add($"search={Uri.EscapeDataString(Search.Trim())}");
            }

            if (IncludeInactive == true)
            {
                parameters.Add("inactive=true");
            }

            if (PageSize is 50 or 100)
            {
                parameters.Add($"pageSize={PageSize.Value}");
            }

            string selectedSort = sort ?? CurrentSort;
            if (SortIsValidForView(view, selectedSort))
            {
                if (selectedSort != "code")
                {
                    parameters.Add($"sort={Uri.EscapeDataString(selectedSort)}");
                }

                if (descending ?? (sort is null && CurrentDescending))
                {
                    parameters.Add("desc=true");
                }
            }
        }

        if (!clearParent && view == "categories" && (parent ?? ParentId) is { } parentId)
        {
            parameters.Add($"parentId={parentId:D}");
        }

        if (page > 1)
        {
            parameters.Add($"page={page}");
        }

        return "/catalog?" + string.Join("&", parameters);
    }
}
