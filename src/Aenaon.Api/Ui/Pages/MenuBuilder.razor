@page "/menus"
@attribute [Authorize]
@attribute [StreamRendering]
@layout MainLayout
@using Aenaon.Application.Menus
@using Aenaon.Domain.Tenancy
@using Aenaon.Domain.Exceptions
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject TenantWorkspaceResolver WorkspaceResolver
@inject WorkspacePreferenceService Preference
@inject MenuDraftManagementService Menus
@inject ILogger<MenuBuilder> Logger

<PageTitle>Διαχείριση Μενού | Aenaon ERP</PageTitle>
<main class="dashboard">
    <BackOfficeSidebar ActivePage="menus" TenantId="@TenantId" StoreId="@StoreId" />
    <div class="dashboard__content">
        <BackOfficeTopbar ActivePage="menus" PageTitle="Διαχείριση Μενού"
                          UserName="@_userName" Workspace="@_workspace"
                          CsrfToken="@_csrfToken" TenantId="@TenantId" StoreId="@StoreId" />

        <div class="dashboard__body catalog-page menu-builder">
            @if (_loading)
            {
                <section class="surface-card catalog-loading" role="status" aria-busy="true">
                    <span class="catalog-loading__indicator" aria-hidden="true"></span>
                    <span>Φόρτωση προσχεδίων μενού…</span>
                </section>
            }
            else if (_workspace is null || _error == "database")
            {
                <div class="form-alert" role="alert">
                    Δεν ήταν δυνατή η φόρτωση μενού. Ελέγξτε τη σύνδεση και το ενημερωμένο Development schema.
                </div>
            }
            else if (_workspace.Status is not (TenantWorkspaceStatus.Ready or TenantWorkspaceStatus.NoStores))
            {
                <div class="workspace-alert" role="alert">Επιλέξτε έγκυρη επιχείρηση και κατάστημα.</div>
                <a href="/dashboard" class="button button--outline">Επιλογή επιχείρησης</a>
            }
            else if (_error is not null || _data is null)
            {
                <div class="form-alert" role="alert">Δεν έχετε πρόσβαση στα συγκεκριμένα μενού.</div>
            }
            else
            {
                @if (!string.IsNullOrEmpty(Message))
                {
                    <div class="@(Result == "saved" ? "catalog-success" : "form-alert")"
                         role="@(Result == "saved" ? "status" : "alert")">@Message</div>
                }

                <section class="surface-card menu-builder__surface">
                    <header class="menu-builder__header">
                        <div>
                            <span class="menu-builder__eyebrow">ΕΣΤΙΑΣΗ · ΑΣΦΑΛΗΣ ΔΙΑΧΕΙΡΙΣΗ</span>
                            <h1>Διαχείριση Μενού</h1>
                            <p>Τα προσχέδια δεν εμφανίζονται σε POS, παραγγελίες ή δημοσιευμένα μενού.</p>
                        </div>
                        <div class="menu-builder__header-actions">
                            <span class="catalog-status catalog-status--active">DRAFT ONLY</span>
                            @if (!CanManage)
                            {
                                <span class="catalog-readonly">Μόνο ανάγνωση</span>
                            }
                        </div>
                    </header>

                    <div class="menu-builder__controls">
                        <form method="get" action="/menus" class="menu-builder__selector">
                            <input type="hidden" name="tenantId" value="@_workspace.Tenant!.TenantId" />
                            @if (_workspace.Store is { } store)
                            {
                                <input type="hidden" name="storeId" value="@store.StoreId" />
                            }
                            <label for="menu-picker">Μενού</label>
                            <select id="menu-picker" name="menuId" accesskey="m"
                                    aria-label="Επιλογή μενού (Alt + M)">
                                @if (_data.Menus.Count == 0)
                                {
                                    <option value="">Δεν υπάρχουν μενού</option>
                                }
                                @foreach (MenuDraftSummary menu in _data.Menus)
                                {
                                    <option value="@menu.MenuId" selected="@(menu.MenuId == _data.Details?.Menu.MenuId)">
                                        @menu.Code — @menu.Name
                                    </option>
                                }
                            </select>
                            <button type="submit" class="button button--outline">Επιλογή</button>
                        </form>
                        @if (CanManage && _csrfToken is not null)
                        {
                            <details class="menu-builder__new-menu">
                                <summary class="button button--primary"><AppIcon Name="plus" /> Νέο μενού</summary>
                                <form method="post" action="/ui/menus/draft" class="menu-builder__inline-form"
                                      data-menu-save="true">
                                    <MenuDraftFormFields TenantId="@_workspace.Tenant!.TenantId"
                                                         StoreId="@_workspace.Store?.StoreId"
                                                         CsrfToken="@_csrfToken" />
                                    <input type="hidden" name="action" value="create-menu" />
                                    <label for="menu-new-code">Κωδικός (μοναδικός)</label>
                                    <input id="menu-new-code" name="code" maxlength="40" required
                                           placeholder="MAIN" autocomplete="off" />
                                    <label for="menu-new-name">Όνομα</label>
                                    <input id="menu-new-name" name="name" maxlength="160" required
                                           placeholder="Κυρίως Μενού" autocomplete="off" />
                                    <p class="menu-builder__hint">Θα προστεθούν αυτόματα όλες οι ενεργές κατηγορίες του ERP Catalog μαζί με τα ενεργά είδη τους, χωρίς αντιγραφή τιμών.</p>
                                    <button type="submit" class="button button--primary">Δημιουργία μενού με είδη ERP</button>
                                </form>
                            </details>
                        }
                    </div>

                    @if (_data.Details is not { } details)
                    {
                        <div class="catalog-empty">
                            <strong>Δεν έχει επιλεγεί μενού.</strong>
                            <p>@(CanManage ? "Δημιουργήστε νέο μενού με αυτόματη μεταφορά ενεργών κατηγοριών και ειδών ERP." :
                                "Δεν υπάρχουν διαθέσιμα προσχέδια στην επιχείρηση.")</p>
                        </div>
                    }
                    else
                    {
                        <div class="menu-builder__current">
                            <div>
                                <strong>@details.Menu.Name</strong>
                                <span class="catalog-code">@details.Menu.Code</span>
                                <small>Αναθεώρηση @details.Menu.Revision</small>
                            </div>
                            @if (CanManage && _csrfToken is not null)
                            {
                                <details>
                                    <summary class="menu-builder__text-action">Μετονομασία</summary>
                                    <form method="post" action="/ui/menus/draft"
                                          class="menu-builder__inline-form" data-menu-save="true">
                                        <MenuDraftFormFields TenantId="@_workspace.Tenant!.TenantId"
                                                             StoreId="@_workspace.Store?.StoreId"
                                                             MenuId="@details.Menu.MenuId"
                                                             Revision="@details.Menu.Revision"
                                                             CsrfToken="@_csrfToken" />
                                        <input type="hidden" name="action" value="update-menu" />
                                        <label for="menu-rename">Όνομα μενού</label>
                                        <input id="menu-rename" name="name" maxlength="160" required
                                               value="@details.Menu.Name" />
                                        <button type="submit" class="button button--primary">Αποθήκευση ονόματος</button>
                                    </form>
                                </details>
                            }
                        </div>

                        @if (CanManage && _csrfToken is not null &&
                            details.Categories.Count == 0 && details.Items.Count == 0)
                        {
                            <section class="menu-builder__import" aria-label="Εισαγωγή από ERP Catalog">
                                <div>
                                    <strong>Το μενού δεν έχει ακόμη κατηγορίες και είδη.</strong>
                                    <p>Φόρτωσε τις ενεργές κατηγορίες μαζί με τα ενεργά είδη τους από το ERP Catalog. Οι υπάρχουσες εγγραφές του ERP δεν αλλάζουν.</p>
                                </div>
                                <form method="post" action="/ui/menus/draft">
                                    <MenuDraftFormFields TenantId="@_workspace.Tenant!.TenantId"
                                                         StoreId="@_workspace.Store?.StoreId"
                                                         MenuId="@details.Menu.MenuId"
                                                         Revision="@details.Menu.Revision"
                                                         CsrfToken="@_csrfToken" />
                                    <input type="hidden" name="action" value="import-catalog" />
                                    <button type="submit" class="button button--primary">
                                        <AppIcon Name="plus" /> Φόρτωση κατηγοριών και ειδών ERP
                                    </button>
                                </form>
                            </section>
                        }


                        @* Οι κατηγορίες και τα είδη εμφανίζονται στο ίδιο επίπεδο, με ασφαλή πλοήγηση στην ιεραρχία. *@
                        Guid? currentCategoryId = SelectedCategory?.CategoryId;
                            var childCategories = details.Categories.Where(x =>
                                x.ParentCategoryId == currentCategoryId)
                                .OrderBy(x => x.Position).ThenBy(x => x.CategoryId).ToList();
                            var currentItems = details.Items.Where(x =>
                                x.CategoryId == currentCategoryId)
                                .OrderBy(x => x.Position).ThenBy(x => x.ItemId).ToList();
                            var breadcrumbs = CategoryPath(details.Categories, SelectedCategory);
                        <nav class="menu-builder__breadcrumbs" aria-label="Διαδρομή μενού">
                            <a href="@Url(details.Menu.MenuId, null, "categories")"
                               aria-current="@(currentCategoryId is null ? "page" : null)">
                                <AppIcon Name="folder-tree" /> Αρχικό μενού
                            </a>
                            @foreach (MenuDraftCategoryRecord crumb in breadcrumbs)
                            {
                                <AppIcon Name="chevron" />
                                @if (crumb.CategoryId == currentCategoryId)
                                {
                                    <span aria-current="page">@DisplayCategoryName(crumb)</span>
                                }
                                else
                                {
                                    <a href="@Url(details.Menu.MenuId, crumb.CategoryId, "items")">
                                        @DisplayCategoryName(crumb)
                                    </a>
                                }
                            }
                        </nav>
                        <section class="menu-builder__workspace" aria-labelledby="menu-categories-title">
                            <header class="menu-builder__workspace-header">
                                <div>
                                    <h2 id="menu-categories-title">
                                        @(SelectedCategory is { } selected ? DisplayCategoryName(selected) : "Κατηγορίες μενού")
                                    </h2>
                                    <p>Κατηγορίες, υποκατηγορίες και είδη στο τρέχον επίπεδο. Σύρετε το ⠿ για ταξινόμηση.</p>
                                </div>
                                <span class="menu-builder__counter">
                                    @childCategories.Count κατηγορίες · @ItemCountLabel(currentItems.Count)
                                </span>
                            </header>
                            <div class="menu-builder__tiles menu-builder__tiles--categories" data-menu-sortable="category">
                                @foreach (MenuDraftCategoryRecord menuCategory in childCategories)
                                {
                                    var categoryImpact = RemovalImpact(details, menuCategory.CategoryId);
                                    <MenuDraftCategoryTile Category="@menuCategory"
                                                           TenantId="@_workspace.Tenant!.TenantId"
                                                           StoreId="@_workspace.Store?.StoreId"
                                                           MenuId="@details.Menu.MenuId"
                                                           Revision="@details.Menu.Revision"
                                                           CsrfToken="@(_csrfToken ?? "")"
                                                           CanManage="@CanManage"
                                                           ReturnCategoryId="@currentCategoryId"
                                                           ItemCount="@details.Items.Count(x => x.CategoryId == menuCategory.CategoryId)"
                                                           ChildCount="@details.Categories.Count(x => x.ParentCategoryId == menuCategory.CategoryId)"
                                                           DescendantCategoryCount="@categoryImpact.Descendants"
                                                           SubtreeItemCount="@categoryImpact.Items"
                                                           SiblingCount="@childCategories.Count"
                                                           Href="@Url(details.Menu.MenuId, menuCategory.CategoryId, "items")" />
                                }
                                @if (CanManage && _csrfToken is not null)
                                {
                                    <details class="menu-builder__tile menu-builder__tile--create" id="menu-create-category">
                                        <summary class="menu-builder__create-trigger" title="Προσθήκη κατηγορίας ή υποκατηγορίας">
                                            <span class="menu-builder__tile-symbol" aria-hidden="true"><AppIcon Name="plus" /></span>
                                            <span>@(currentCategoryId.HasValue ? "Νέα υποκατηγορία" : "Νέα κατηγορία")</span>
                                        </summary>
                                        <form method="post" action="/ui/menus/draft"
                                              class="menu-builder__inline-form" data-menu-save="true">
                                            <MenuDraftFormFields TenantId="@_workspace.Tenant!.TenantId"
                                                                 StoreId="@_workspace.Store?.StoreId"
                                                                 MenuId="@details.Menu.MenuId"
                                                                 Revision="@details.Menu.Revision"
                                                                 CsrfToken="@_csrfToken" />
                                            @if (currentCategoryId.HasValue)
                                            {
                                                <input type="hidden" name="parentCategoryId" value="@currentCategoryId" />
                                            }
                                            <input type="hidden" name="action" value="add-category" />
                                            <label for="menu-category-new">Όνομα νέας @(currentCategoryId.HasValue ? "υποκατηγορίας" : "κατηγορίας")</label>
                                            <input id="menu-category-new" name="name" maxlength="160"
                                                   required autocomplete="off" placeholder="π.χ. Αναψυκτικά" />
                                            <button type="submit" class="button button--primary">
                                                <AppIcon Name="check" /> Προσθήκη
                                            </button>
                                        </form>
                                    </details>
                                }
                            </div>

                            <header class="menu-builder__workspace-header menu-builder__items-header">
                                <div>
                                    <h2 id="menu-items-title">Είδη @(currentCategoryId.HasValue ? "κατηγορίας" : "αρχικού μενού")</h2>
                                    <p>Μπορείτε να τοποθετήσετε είδη και στην αρχική οθόνη, χωρίς κατηγορία.</p>
                                </div>
                                <a class="menu-builder__compact-action"
                                   href="@Url(details.Menu.MenuId, currentCategoryId, "catalog")">
                                    <AppIcon Name="plus" /> Από ERP Catalog
                                </a>
                            </header>
                            @if (childCategories.Count == 0 && currentItems.Count == 0)
                            {
                                <div class="menu-builder__empty" role="status">
                                    Αυτό το επίπεδο είναι κενό. Προσθέστε κατηγορία, υποκατηγορία ή είδος.
                                </div>
                            }
                            <div class="menu-builder__tiles menu-builder__tiles--items" data-menu-sortable="item"
                                 aria-labelledby="menu-items-title">
                                @foreach (MenuDraftItemRecord item in currentItems)
                                {
                                    <MenuDraftItemTile Item="@item"
                                                       TenantId="@_workspace.Tenant!.TenantId"
                                                       StoreId="@_workspace.Store?.StoreId"
                                                       MenuId="@details.Menu.MenuId"
                                                       CategoryId="@currentCategoryId"
                                                       Revision="@details.Menu.Revision"
                                                       CsrfToken="@(_csrfToken ?? "")"
                                                       CanManage="@CanManage"
                                                       SiblingCount="@currentItems.Count" />
                                }
                            </div>

                            <details class="menu-builder__catalog-drawer" open="@(SelectedTab == "catalog")"
                                     id="menu-erp-catalog">
                                <summary class="menu-builder__drawer-trigger">
                                    <AppIcon Name="catalog" />
                                    <span>Επιπλέον είδη από ERP Catalog</span>
                                    <small>Προσθήκη στο τρέχον επίπεδο · χωρίς αλλαγή στον κεντρικό κατάλογο</small>
                                    <AppIcon Name="chevron" />
                                </summary>
                                <section class="menu-builder__column menu-builder__column--catalog"
                                         aria-labelledby="menu-catalog-title">
                                    <header class="menu-builder__column-header">
                                        <h2 id="menu-catalog-title">Κατάλογος ERP</h2>
                                        <small>Μόνο ενεργά είδη · έως 50 ανά αναζήτηση</small>
                                    </header>
                                    <form method="get" action="/menus" class="menu-builder__search" role="search">
                                        <input type="hidden" name="tenantId" value="@_workspace.Tenant!.TenantId" />
                                        @if (_workspace.Store is { } catalogStore)
                                        {
                                            <input type="hidden" name="storeId" value="@catalogStore.StoreId" />
                                        }
                                        <input type="hidden" name="menuId" value="@details.Menu.MenuId" />
                                        @if (currentCategoryId.HasValue)
                                        {
                                            <input type="hidden" name="categoryId" value="@currentCategoryId" />
                                        }
                                        <input type="hidden" name="tab" value="catalog" />
                                        <label for="menu-catalog-search">Αναζήτηση είδους ή κωδικού</label>
                                        <div class="menu-builder__search-fields">
                                            <input id="menu-catalog-search" name="search" maxlength="80"
                                                   type="search" value="@Search"
                                                   placeholder="Αρχή κωδικού ή ονόματος…" />
                                            <button type="submit" class="button button--outline" accesskey="f">
                                                <AppIcon Name="search" /> Αναζήτηση
                                            </button>
                                        </div>
                                    </form>
                                    @if (CanManage && _csrfToken is not null &&
                                        _data.Catalog.Any(x => !details.Items.Any(item =>
                                            item.CategoryId == currentCategoryId && item.CatalogItemId == x.CatalogItemId)))
                                    {
                                        <form id="menu-bulk-add" method="post" action="/ui/menus/draft"
                                              class="menu-builder__bulk-actions" data-menu-bulk-form>
                                            <MenuDraftFormFields TenantId="@_workspace.Tenant!.TenantId"
                                                                 StoreId="@_workspace.Store?.StoreId"
                                                                 MenuId="@details.Menu.MenuId"
                                                                 CategoryId="@currentCategoryId"
                                                                 Revision="@details.Menu.Revision"
                                                                 CsrfToken="@_csrfToken" />
                                            <input type="hidden" name="action" value="add-items" />
                                            <div class="menu-builder__bulk-toolbar">
                                                <strong>Επιλογή πολλών ειδών</strong>
                                                <output data-menu-selected-count aria-live="polite">0 επιλεγμένα</output>
                                                <button type="button" class="button button--outline" data-menu-select-all>
                                                    Επιλογή όλων
                                                </button>
                                                <button type="button" class="button button--outline" data-menu-clear-selection>
                                                    Καθαρισμός
                                                </button>
                                                <button type="submit" class="button button--primary" data-menu-bulk-submit disabled>
                                                    Προσθήκη επιλεγμένων
                                                </button>
                                            </div>
                                            <small>Μέχρι 50 διαφορετικά είδη ανά αποθήκευση, χωρίς αλλαγή στον ERP Catalog.</small>
                                        </form>
                                    }
                                    @if (_data.Catalog.Count == 0)
                                    {
                                        <div class="menu-builder__empty">Δεν βρέθηκαν ενεργά είδη καταλόγου.</div>
                                    }
                                    @foreach (MenuCatalogOption catalogItem in _data.Catalog)
                                    {
                                        <article class="menu-builder__catalog-entry">
                                            <div>
                                                <strong>@catalogItem.Name</strong>
                                                <small>@catalogItem.Code</small>
                                            </div>
                                            @if (details.Items.Any(x => x.CategoryId == currentCategoryId &&
                                                x.CatalogItemId == catalogItem.CatalogItemId))
                                            {
                                                <span class="menu-builder__already">Προστέθηκε</span>
                                            }
                                            else if (CanManage && _csrfToken is not null)
                                            {
                                                <label class="menu-builder__bulk-option"
                                                       for="@($"menu-select-{catalogItem.CatalogItemId:N}")">
                                                    <input id="@($"menu-select-{catalogItem.CatalogItemId:N}")"
                                                           form="menu-bulk-add" type="checkbox"
                                                           name="catalogItemIds" value="@catalogItem.CatalogItemId"
                                                           data-menu-bulk-checkbox
                                                           aria-label="Επιλογή @catalogItem.Name για μαζική προσθήκη" />
                                                    Επιλογή
                                                </label>
                                                <form method="post" action="/ui/menus/draft">
                                                    <MenuDraftFormFields TenantId="@_workspace.Tenant!.TenantId"
                                                                         StoreId="@_workspace.Store?.StoreId"
                                                                         MenuId="@details.Menu.MenuId"
                                                                         CategoryId="@currentCategoryId"
                                                                         Revision="@details.Menu.Revision"
                                                                         CsrfToken="@_csrfToken" />
                                                    <input type="hidden" name="action" value="add-item" />
                                                    <input type="hidden" name="catalogItemId" value="@catalogItem.CatalogItemId" />
                                                    <button class="menu-builder__add-item" type="submit"
                                                            title="Προσθήκη στο τρέχον επίπεδο">
                                                        <span aria-hidden="true">+</span>
                                                        <span class="visually-hidden">Προσθήκη @catalogItem.Name</span>
                                                    </button>
                                                </form>
                                            }
                                        </article>
                                    }
                                </section>
                            </details>
                        </section>
                        <div class="menu-builder__footnote">
                            Η αποθήκευση γίνεται σε κάθε ενέργεια. Συντόμευση Ctrl+S μέσα σε φόρμα ·
                            αλλαγή σειράς με drag & drop ή ↑/↓ και πληκτρολόγιο. Δεν υπάρχουν Publish, Modifiers ή POS στο 9.6A.1.
                        </div>
                    }
                </section>
            }
        </div>
        <footer class="dashboard__footer">© @DateTime.UtcNow.Year Aenaon ERP · by MoonHard
            <span>Built with .NET &amp; Blazor</span>
        </footer>
    </div>
</main>

@code {
    [SupplyParameterFromQuery(Name = "tenantId")] public Guid? TenantId { get; set; }
    [SupplyParameterFromQuery(Name = "storeId")] public Guid? StoreId { get; set; }
    [SupplyParameterFromQuery(Name = "menuId")] public Guid? MenuId { get; set; }
    [SupplyParameterFromQuery(Name = "categoryId")] public Guid? CategoryId { get; set; }
    [SupplyParameterFromQuery(Name = "search")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }
    [SupplyParameterFromQuery(Name = "result")] public string? Result { get; set; }

    private TenantWorkspaceSnapshot? _workspace;
    private MenuDraftReadResult? _data;
    private string? _csrfToken;
    private string _userName = "Χρήστης";
    private string? _error;
    private bool _loading = true;

    private bool CanManage => _workspace?.Tenant?.Role == TenantMembershipRole.Owner &&
        _workspace.Status is (TenantWorkspaceStatus.Ready or TenantWorkspaceStatus.NoStores);

    private MenuDraftCategoryRecord? SelectedCategory =>
        CategoryId.HasValue
            ? _data?.Details?.Categories.FirstOrDefault(x => x.CategoryId == CategoryId.Value)
            : null;

    private string SelectedTab => Tab is "items" or "catalog" ? Tab : "categories";

    private string? Message => Result switch
    {
        "saved" => "Το προσχέδιο αποθηκεύτηκε επιτυχώς.",
        "items-added" => "Τα επιλεγμένα είδη προστέθηκαν μαζί στο μενού.",
        "duplicate" => "Η καταχώριση υπάρχει ήδη σε αυτό το μενού ή η τιμή κωδικού χρησιμοποιείται.",
        "conflict" => "Το προσχέδιο άλλαξε από άλλη συνεδρία. Φορτώστε ξανά τη σελίδα και επανελέγξτε τις αλλαγές σας.",
        "missing" => "Η επιλεγμένη εγγραφή δεν βρέθηκε. Ελέγξτε την τρέχουσα κατάσταση.",
        "empty-catalog" => "Ο ERP Catalog δεν έχει ενεργές κατηγορίες προς εισαγωγή.",
        "import-limit" => "Ο κατάλογος ξεπερνά το ασφαλές όριο αυτόματης εισαγωγής. Δεν αποθηκεύτηκε μερικό μενού.",
        "import-not-empty" => "Το μενού έχει ήδη κατηγορίες ή είδη. Η αυτόματη εισαγωγή επιτρέπεται μόνο σε κενό μενού.",
        "confirm-remove" => "Για αφαίρεση κατηγορίας με περιεχόμενο απαιτείται ρητή επιβεβαίωση.",
        "invalid" => "Τα στοιχεία δεν είναι έγκυρα. Ελέγξτε την επιλογή ειδών, τα δικαιώματα και την τρέχουσα αναθεώρηση.",
        _ => null
    };

    // Υπολογισμός επίδρασης διαγραφής σε όλα τα επίπεδα, χωρίς αλλαγή δεδομένων.
    private static (int Descendants, int Items) RemovalImpact(MenuDraftDetails details, Guid rootId)
    {
        ILookup<Guid?, MenuDraftCategoryRecord> byParent =
            details.Categories.ToLookup(x => x.ParentCategoryId);
        var ids = new HashSet<Guid>();
        var pending = new Stack<Guid>();
        pending.Push(rootId);
        while (pending.TryPop(out Guid categoryId))
        {
            if (!ids.Add(categoryId))
            {
                continue;
            }
            foreach (MenuDraftCategoryRecord child in byParent[categoryId])
            {
                pending.Push(child.CategoryId);
            }
        }
        int items = details.Items.Count(x => x.CategoryId is Guid categoryId && ids.Contains(categoryId));
        return (ids.Count - 1, items);
    }

    private static string ItemCountLabel(int count) => count == 1 ? "1 είδος" : $"{count} είδη";

    private static string DisplayCategoryName(MenuDraftCategoryRecord category) =>
        category.ParentCategoryId.HasValue &&
        category.Name.Contains(" / ", StringComparison.Ordinal)
            ? category.Name[(category.Name.LastIndexOf(" / ", StringComparison.Ordinal) + 3)..]
            : category.Name;

    private static IReadOnlyList<MenuDraftCategoryRecord> CategoryPath(
        IReadOnlyList<MenuDraftCategoryRecord> all, MenuDraftCategoryRecord? selected)
    {
        if (selected is null)
        {
            return [];
        }

        var byId = all.ToDictionary(x => x.CategoryId);
        var result = new List<MenuDraftCategoryRecord>();
        var seen = new HashSet<Guid>();
        MenuDraftCategoryRecord? current = selected;
        while (current is not null && result.Count < 64 && seen.Add(current.CategoryId))
        {
            result.Add(current);
            current = current.ParentCategoryId is { } parentId &&
                byId.TryGetValue(parentId, out MenuDraftCategoryRecord? parent)
                ? parent : null;
        }
        result.Reverse();
        return result;
    }

    private string Url(Guid? menuId = null, Guid? categoryId = null,
        string tab = "categories")
    {
        string url = $"/menus?tenantId={_workspace!.Tenant!.TenantId:D}";
        if (_workspace.Store is { } store)
        {
            url += $"&storeId={store.StoreId:D}";
        }
        if (menuId.HasValue)
        {
            url += $"&menuId={menuId.Value:D}";
        }
        if (categoryId.HasValue)
        {
            url += $"&categoryId={categoryId.Value:D}";
        }
        if (!string.IsNullOrWhiteSpace(Search) && Search.Length <= 80)
        {
            url += $"&search={Uri.EscapeDataString(Search.Trim())}";
        }
        return url + $"&tab={tab}";
    }

    protected override async Task OnParametersSetAsync()
    {
        _workspace = null;
        _data = null;
        _error = null;
        _loading = true;
        HttpContext? context = HttpContextAccessor.HttpContext;
        if (context?.Request.IsHttps != true ||
            context.User.Identity?.IsAuthenticated != true ||
            !Guid.TryParse(context.User.FindFirstValue(ClaimTypes.NameIdentifier), out Guid userId) ||
            userId == Guid.Empty)
        {
            _error = "database";
            _loading = false;
            return;
        }

        _userName = context.User.Identity.Name ?? "Χρήστης";
        _csrfToken = Antiforgery.GetAndStoreTokens(context).RequestToken;
        context.Response.Headers.CacheControl = "no-store";

        try
        {
            Guid? tenant = TenantId;
            Guid? store = StoreId;
            if (!tenant.HasValue && !store.HasValue &&
                Preference.TryRead(context, userId, out Guid rememberedTenant, out Guid? rememberedStore))
            {
                tenant = rememberedTenant;
                store = rememberedStore;
            }
            _workspace = await WorkspaceResolver.ResolveAsync(userId, tenant, store,
                context.RequestAborted);
            if (_workspace.Status is TenantWorkspaceStatus.Ready or TenantWorkspaceStatus.NoStores)
            {
                _data = await Menus.ReadAsync(userId, _workspace.Tenant!.TenantId,
                    MenuId, Search, context.RequestAborted, _workspace.Store?.StoreId);
                if (!_data.IsAuthorized)
                {
                    _error = "access";
                }
            }
        }
        catch (DomainRuleException)
        {
            _error = "query";
        }
        catch (OperationCanceledException) when (context.RequestAborted.IsCancellationRequested)
        {
            throw;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Menu Builder loading failed");
            _error = "database";
        }
        finally
        {
            _loading = false;
        }
    }
}
