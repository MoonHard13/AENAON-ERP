@page "/price-lists"
@attribute [Authorize]
@attribute [StreamRendering]
@layout MainLayout
@using Aenaon.Application.Catalog
@using Aenaon.Domain.Catalog
@using Aenaon.Domain.Tenancy
@using Aenaon.Domain.Exceptions
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject TenantWorkspaceResolver WorkspaceResolver
@inject WorkspacePreferenceService Preference
@inject PriceListManagementService Manager
@inject ILogger<PriceLists> Logger

<PageTitle>Τιμοκατάλογοι | Aenaon ERP</PageTitle>
<main class="dashboard">
    <BackOfficeSidebar ActivePage="price-lists" TenantId="@TenantId" StoreId="@StoreId" />
    <div class="dashboard__content">
        <BackOfficeTopbar ActivePage="price-lists" PageTitle="Τιμοκατάλογοι"
                          UserName="@_userName" Workspace="@_workspace"
                          CsrfToken="@_csrfToken" TenantId="@TenantId" StoreId="@StoreId" />
        <div class="dashboard__body catalog-page price-lists-page">
            @if (_loading)
            {
                <section class="surface-card catalog-loading" aria-busy="true" role="status">
                    <span class="catalog-loading__indicator" aria-hidden="true"></span>
                    <span>Φόρτωση τιμοκαταλόγων…</span>
                </section>
            }
            else if (_workspace is null || _error == "database")
            {
                <div class="form-alert" role="alert">Δεν ήταν δυνατή η φόρτωση. Ελέγξτε τη σύνδεση με τη βάση.</div>
            }
            else if (_workspace.Status is not (TenantWorkspaceStatus.Ready or TenantWorkspaceStatus.NoStores))
            {
                <div class="workspace-alert" role="alert">Επιλέξτε έγκυρη επιχείρηση και κατάστημα.</div>
                <a class="button button--outline" href="/dashboard">Επιλογή επιχείρησης</a>
            }
            else if (_error is not null)
            {
                <div class="form-alert" role="alert">Η αναζήτηση δεν είναι έγκυρη ή δεν έχετε δικαίωμα προβολής.</div>
            }
            else if (_page is not null)
            {
                @if (Saved == 1)
                {
                    <div class="catalog-success" role="status"><AppIcon Name="check" /> Η αλλαγή αποθηκεύτηκε επιτυχώς.</div>
                }
                <section class="surface-card catalog-surface" aria-labelledby="price-list-title">
                    <div class="catalog-surface__header">
                        <div class="catalog-surface__identity">
                            <h1 id="price-list-title">Τιμοκατάλογοι</h1>
                            <span class="count-pill">@_page.Rows.Count εγγραφές στη σελίδα</span>
                        </div>
                        <div class="catalog-surface__actions">
                            <a class="button button--outline" href="@PreviewUrl()" accesskey="p"
                               title="Προεπισκόπηση εμπορικής τιμής (συντόμευση P)">
                                <AppIcon Name="search" /> Προεπισκόπηση τιμής
                            </a>
                            @if (CanManage)
                            {
                                <a class="button button--primary catalog-create" href="@ManageUrl()" accesskey="n" title="Νέος τιμοκατάλογος (συντόμευση N)">
                                    <AppIcon Name="plus" /> Νέος τιμοκατάλογος
                                </a>
                            }
                            else
                            {
                                <span class="catalog-readonly"><AppIcon Name="shield" /> Μόνο ανάγνωση</span>
                            }
                        </div>
                    </div>
                    <form class="catalog-filters" method="get" action="/price-lists" role="search" aria-label="Αναζήτηση τιμοκαταλόγων">
                        @if (_workspace.Tenant is { } tenant)
                        {
                            <input type="hidden" name="tenantId" value="@tenant.TenantId" />
                        }
                        @if (_workspace.Store is { } store)
                        {
                            <input type="hidden" name="storeId" value="@store.StoreId" />
                        }
                        <div class="catalog-field catalog-field--search">
                            <label for="price-list-search">Κωδικός ή περιγραφή (αρχίζει από)</label>
                            <div class="catalog-search">
                                <AppIcon Name="search" />
                                <input id="price-list-search" name="search" type="search" accesskey="f"
                                       maxlength="80" autocomplete="off" value="@Search"
                                       placeholder="Αναζήτηση τιμοκαταλόγου…" />
                            </div>
                        </div>
                        <label class="catalog-checkbox">
                            <input type="checkbox" name="inactive" value="true" checked="@(Inactive == true)" />
                            Συμπερίληψη ανενεργών
                        </label>
                        <button type="submit" class="button button--primary catalog-filter-button">
                            <AppIcon Name="search" /> Αναζήτηση
                        </button>
                        <a class="catalog-reset" href="@IndexUrl()">Καθαρισμός</a>
                    </form>
                    @if (_page.Rows.Count == 0)
                    {
                        <div class="price-list-empty">
                            <strong>Δεν υπάρχουν τιμοκατάλογοι.</strong>
                            <p>@(CanManage ? "Χρησιμοποιήστε το κουμπί «Νέος τιμοκατάλογος»." : "Δεν βρέθηκαν εγγραφές με αυτά τα φίλτρα.")</p>
                        </div>
                    }
                    else
                    {
                        <div class="catalog-table-wrap" tabindex="0" role="region"
                             aria-label="Τιμοκατάλογοι">
                            <table class="catalog-table mobile-card-table mobile-price-lists-table">
                                <thead>
                                    <tr>
                                        <th scope="col">Κωδικός</th>
                                        <th scope="col">Περιγραφή</th>
                                        <th scope="col">Κανάλι</th>
                                        <th scope="col">Κατάστημα</th>
                                        <th scope="col">Ισχύς</th>
                                        <th scope="col">Είδη</th>
                                        <th scope="col">Κατάσταση</th>
                                        <th scope="col">Ενέργειες</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (PriceListSummary row in _page.Rows)
                                    {
                                        <tr>
                                            <td data-label="Κωδικός" class="mobile-card-primary"><strong>@row.Code</strong></td>
                                            <td data-label="Περιγραφή" class="mobile-card-title">@row.Name <small class="price-list-hint">@(row.PricesIncludeVat ? "Με ΦΠΑ" : "Χωρίς ΦΠΑ")</small></td>
                                            <td data-label="Κανάλι">@ChannelLabel(row.Channel)</td>
                                            <td data-label="Κατάστημα">@StoreLabel(row.StoreId)</td>
                                            <td data-label="Ισχύς"><span class="price-list-nowrap">@row.ValidFrom.ToString("dd/MM/yyyy")</span>
                                                <span class="price-list-hint">έως @(row.ValidUntil?.ToString("dd/MM/yyyy") ?? "χωρίς λήξη")</span></td>
                                            <td data-label="Είδη">@row.ItemCount</td>
                                            <td data-label="Κατάσταση"><span class="@(row.IsActive ? "catalog-status catalog-status--active" : "catalog-status catalog-status--inactive")">
                                                @(row.IsActive ? "Ενεργός" : "Ανενεργός")
                                            </span></td>
                                            <td data-label="Ενέργειες"><a class="catalog-edit-link" href="@ManageUrl(row.Id)">@(CanManage ? "Διαχείριση" : "Προβολή")</a></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (_page.Page > 1 || _page.HasMore)
                        {
                            <nav class="catalog-pagination" aria-label="Σελιδοποίηση τιμοκαταλόγων">
                                @if (_page.Page > 1)
                                {
                                    <a href="@ListUrl(_page.Page - 1)" rel="prev">Προηγούμενη</a>
                                }
                                <span>Σελίδα @_page.Page</span>
                                @if (_page.HasMore)
                                {
                                    <a href="@ListUrl(_page.Page + 1)" rel="next">Επόμενη</a>
                                }
                            </nav>
                        }
                    }
                </section>
                <p class="catalog-disclaimer">Οι τιμές είναι εμπορικά δεδομένα. Δεν δημιουργούνται παραστατικά και δεν ορίζονται χαρακτηρισμοί myDATA ή IMPACT.</p>
            }
        </div>
        <footer class="dashboard__footer">© @DateTime.UtcNow.Year Aenaon ERP · by MoonHard <span>Built with .NET &amp; Blazor</span></footer>
    </div>
</main>

@code {
    [SupplyParameterFromQuery(Name = "tenantId")] public Guid? TenantId { get; set; }
    [SupplyParameterFromQuery(Name = "storeId")] public Guid? StoreId { get; set; }
    [SupplyParameterFromQuery(Name = "search")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "inactive")] public bool? Inactive { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? Page { get; set; }
    [SupplyParameterFromQuery(Name = "saved")] public int? Saved { get; set; }

    private TenantWorkspaceSnapshot? _workspace;
    private PriceListPage? _page;
    private string? _csrfToken;
    private string _userName = "Χρήστης";
    private string? _error;
    private bool _loading = true;

    private bool CanManage => _workspace?.Tenant?.Role == TenantMembershipRole.Owner &&
        _workspace.Status is (TenantWorkspaceStatus.Ready or TenantWorkspaceStatus.NoStores);

    private string StoreLabel(Guid? id) => id is null ? "Όλα τα καταστήματα" :
        _workspace?.Stores.FirstOrDefault(x => x.StoreId == id.Value)?.Name ?? "Άγνωστο κατάστημα";

    private static string ChannelLabel(PriceListChannel channel) => channel switch
    {
        PriceListChannel.DineIn => "Dine In",
        PriceListChannel.Takeaway => "Takeaway",
        PriceListChannel.Delivery => "Delivery",
        PriceListChannel.Retail => "Λιανική",
        PriceListChannel.Online => "Online",
        _ => "Όλα"
    };

    private string IndexUrl()
    {
        string result = "/price-lists";
        if (_workspace?.Tenant is { } tenant)
        {
            result += $"?tenantId={tenant.TenantId:D}";
            if (_workspace.Store is { } store) result += $"&storeId={store.StoreId:D}";
        }
        return result;
    }

    private string PreviewUrl() =>
        IndexUrl().Replace("/price-lists", "/price-lists/preview", StringComparison.Ordinal);

    private string ManageUrl(Guid? id = null) =>
        "/price-lists/manage" + IndexUrl().Replace("/price-lists", "") +
        (id.HasValue ? (IndexUrl().Contains('?') ? "&" : "?") + $"id={id.Value:D}" : "");

    private string ListUrl(int page)
    {
        string result = IndexUrl() + (IndexUrl().Contains('?') ? "&" : "?") + $"page={page}";
        if (!string.IsNullOrWhiteSpace(Search)) result += $"&search={Uri.EscapeDataString(Search.Trim())}";
        if (Inactive == true) result += "&inactive=true";
        return result;
    }

    protected override async Task OnParametersSetAsync()
    {
        _workspace = null;
        _page = null;
        _error = null;
        _loading = true;
        HttpContext? context = HttpContextAccessor.HttpContext;
        if (context?.Request.IsHttps != true ||
            context.User.Identity?.IsAuthenticated != true ||
            !Guid.TryParse(context.User.FindFirstValue(ClaimTypes.NameIdentifier), out Guid userId) ||
            userId == Guid.Empty)
        {
            _error = "database";
            _loading = false;
            return;
        }

        _userName = context.User.Identity.Name ?? "Χρήστης";
        _csrfToken = Antiforgery.GetAndStoreTokens(context).RequestToken;
        context.Response.Headers.CacheControl = "no-store";
        try
        {
            Guid? tenantId = TenantId;
            Guid? storeId = StoreId;
            if (!tenantId.HasValue && !storeId.HasValue &&
                Preference.TryRead(context, userId, out Guid rememberedTenant, out Guid? rememberedStore))
            {
                tenantId = rememberedTenant;
                storeId = rememberedStore;
            }

            _workspace = await WorkspaceResolver.ResolveAsync(userId, tenantId, storeId, context.RequestAborted);
            if (_workspace.Status is TenantWorkspaceStatus.Ready or TenantWorkspaceStatus.NoStores)
            {
                _page = await Manager.ListAsync(userId, _workspace.Tenant!.TenantId,
                    Search, Inactive == true, Page ?? 1, 25, context.RequestAborted);
                if (_page is null) _error = "access";
            }
        }
        catch (DomainRuleException)
        {
            _error = "query";
        }
        catch (OperationCanceledException) when (context.RequestAborted.IsCancellationRequested)
        {
            throw;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Price lists page load failed");
            _error = "database";
        }
        finally
        {
            _loading = false;
        }
    }
}
