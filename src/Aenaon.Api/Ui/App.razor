@inject UiAssetVersions AssetVersions

<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <base href="/" />
    <title>Aenaon ERP | by MoonHard</title>
    <link rel="icon" type="image/png" href="@($"/images/aenaon-favicon.png?v={AssetVersions.Favicon}")" />
    <script src="@($"/js/aenaon-theme-init.js?v={AssetVersions.ThemeInitialization}")"></script>
    <link rel="stylesheet" href="@($"/css/aenaon.css?v={AssetVersions.Css}")" />
    <link rel="stylesheet" href="@($"/css/aenaon-backoffice.css?v={AssetVersions.BackOfficeCss}")" />
</head>
<body data-enhance-nav="false">
    <Routes />
    @* Το Blazor script εφαρμόζει τις τελικές SSR ενημερώσεις που έρχονται μετά το αρχικό loading. *@
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@($"/js/aenaon.js?v={AssetVersions.JavaScript}")" defer></script>
</body>
</html>
