@* Κοινή πλοήγηση για όλες τις οθόνες του Back Office. *@
<aside class="sidebar" aria-label="Πλαϊνό μενού">
    <a class="sidebar__brand" href="@DashboardHref" aria-label="Aenaon ERP — Επισκόπηση">
        <div class="sidebar__logo">
            <img src="/images/aenaon-favicon.png" alt="" width="48" height="48" />
        </div>
        <div class="sidebar__brand-text">
            <strong>AENAON</strong><span>ERP · MOONHARD</span>
        </div>
    </a>

    @* Το κουμπί διατηρεί την προτίμηση σε όλες τις SSR σελίδες, χωρίς επιπλέον dependencies. *@
    <button type="button" class="sidebar__collapse-toggle" data-sidebar-toggle
            aria-controls="aenaon-primary-sidebar-nav" aria-pressed="false"
            aria-label="Σύμπτυξη πλαϊνού μενού" title="Σύμπτυξη πλαϊνού μενού" accesskey="x">
        <AppIcon Name="panel-left-close" />
        <span class="sidebar__toggle-label">Σύμπτυξη μενού</span>
    </button>
    <div class="sidebar__section-title">ΠΛΟΗΓΗΣΗ</div>
    <nav id="aenaon-primary-sidebar-nav" class="sidebar__nav" aria-label="Κύρια πλοήγηση">
        <a class="@LinkClass("dashboard")" href="@DashboardHref"
           aria-current="@(ActivePage == "dashboard" ? "page" : null)" title="Επισκόπηση" aria-label="Επισκόπηση">
            <AppIcon Name="overview" /> <span class="sidebar__link-label">Επισκόπηση</span>
        </a>
        <a class="@LinkClass("catalog")" href="@CatalogHref"
           aria-current="@(ActivePage == "catalog" ? "page" : null)" title="Κατάλογος" aria-label="Κατάλογος">
            <AppIcon Name="catalog" /> <span class="sidebar__link-label">Κατάλογος</span>
        </a>
        <a class="@LinkClass("price-lists")" href="@PriceListsHref"
           aria-current="@(ActivePage == "price-lists" ? "page" : null)" title="Τιμοκατάλογοι" aria-label="Τιμοκατάλογοι">
            <AppIcon Name="sales" /> <span class="sidebar__link-label">Τιμοκατάλογοι</span>
        </a>
        <details class="sidebar__upcoming">
            <summary><AppIcon Name="settings" /> Επόμενες λειτουργίες <AppIcon Name="chevron" /></summary>
            <div class="sidebar__upcoming-list" aria-label="Λειτουργίες υπό ανάπτυξη">
                <span><AppIcon Name="sales" /> Εμπορική διαχείριση</span>
                <span><AppIcon Name="warehouse" /> Αποθήκη</span>
                <span><AppIcon Name="settings" /> Ρυθμίσεις</span>
                <small>Υπό ανάπτυξη</small>
            </div>
        </details>
    </nav>
    <div class="sidebar__foot">
        <span class="sidebar__status-dot"></span> ΠΕΡΙΒΑΛΛΟΝ ΑΝΑΠΤΥΞΗΣ
        <span class="sidebar__version">Aenaon ERP · Build @UiAppInfo.Version</span>
    </div>
</aside>

@code {
    [Parameter] public string ActivePage { get; set; } = "dashboard";
    [Parameter] public Guid? TenantId { get; set; }
    [Parameter] public Guid? StoreId { get; set; }

    private string DashboardHref => Href("/dashboard");
    private string CatalogHref => Href("/catalog");
    private string PriceListsHref => Href("/price-lists");

    private string LinkClass(string page) =>
        ActivePage == page ? "sidebar__link sidebar__link--active" : "sidebar__link";

    private string Href(string path)
    {
        if (!TenantId.HasValue)
        {
            return path;
        }

        string url = $"{path}?tenantId={TenantId.Value:D}";
        return StoreId.HasValue ? $"{url}&storeId={StoreId.Value:D}" : url;
    }
}
