@* Ενιαία γραμμή πλοήγησης, προφίλ και CSRF-protected αποσύνδεσης. *@
<header class="topbar">
    <details class="mobile-navigation">
        <summary aria-label="Άνοιγμα πλοήγησης"><AppIcon Name="menu" /> Μενού</summary>
        <nav aria-label="Πλοήγηση μικρής οθόνης">
            <a href="@DashboardHref" aria-current="@(ActivePage == "dashboard" ? "page" : null)">
                <AppIcon Name="overview" /> Επισκόπηση
            </a>
            <a href="@CatalogHref" aria-current="@(ActivePage == "catalog" ? "page" : null)">
                <AppIcon Name="catalog" /> Κατάλογος
            </a>
            <a href="@PriceListsHref" aria-current="@(ActivePage == "price-lists" ? "page" : null)">
                <AppIcon Name="sales" /> Τιμοκατάλογοι
            </a>
            <span><AppIcon Name="settings" /> Περισσότερες λειτουργίες υπό ανάπτυξη</span>
        </nav>
    </details>
    <nav class="breadcrumb" aria-label="Διαδρομή πλοήγησης">
        @if (ActivePage == "dashboard")
        {
            <strong aria-current="page">Επισκόπηση</strong>
        }
        else if (ActivePage == "catalog")
        {
            <a href="@CatalogHref">Κατάλογος</a>
            @if (!string.IsNullOrWhiteSpace(BreadcrumbSection))
            {
                <span aria-hidden="true">/</span>
                <a href="@(BreadcrumbSectionHref ?? CatalogHref)">@BreadcrumbSection</a>
            }
            @if (PageTitle != "Κατάλογος")
            {
                <span aria-hidden="true">/</span>
                <strong aria-current="page">@PageTitle</strong>
            }
        }
        else if (ActivePage == "price-lists")
        {
            <a href="@PriceListsHref">Τιμοκατάλογοι</a>
            @if (PageTitle != "Τιμοκατάλογοι")
            {
                <span aria-hidden="true">/</span>
                <strong aria-current="page">@PageTitle</strong>
            }
        }
        else
        {
            <strong aria-current="page">@PageTitle</strong>
        }
    </nav>
    <div class="topbar__actions">
        @* Το πλαίσιο εργασίας προβάλλεται συμπαγές· η αλλαγή εξακολουθεί να γίνεται με ασφαλές POST στο Dashboard. *@
        <a class="workspace-indicator" href="@WorkspaceSelectionHref"
           aria-label="Αλλαγή επιχείρησης ή καταστήματος"
           title="Αλλαγή επιχείρησης ή καταστήματος">
            <AppIcon Name="building" />
            @if (ActiveWorkspace is { } selected)
            {
                <span class="workspace-indicator__tenant">@(selected.Tenant!.Name)</span>
                @if (selected.Store is { } store)
                {
                    <span class="workspace-indicator__divider" aria-hidden="true">/</span>
                    <span class="workspace-indicator__store">@store.Name (@store.Code)</span>
                }
            }
            else
            {
                <span class="workspace-indicator__tenant">Επιλογή επιχείρησης</span>
            }
            <AppIcon Name="chevron" />
        </a>
        <button type="button" class="theme-toggle" data-theme-toggle aria-label="Εναλλαγή θέματος">
            <AppIcon Name="sun-moon" /> <span data-theme-label>Θέμα</span>
        </button>
        <details class="user-menu">
            <summary aria-label="Μενού χρήστη @UserName">
                <span class="topbar__avatar" aria-hidden="true">@Initials</span>
                <span class="topbar__username">@UserName</span>
                <AppIcon Name="chevron" />
            </summary>
            <div class="user-menu__panel">
                <div class="user-menu__identity">
                    <span class="user-menu__avatar">@Initials</span>
                    <div>
                        <strong>@UserName</strong>
                        <small>@(ActiveWorkspace?.Tenant?.Name ?? "Aenaon ERP")</small>
                    </div>
                </div>
                <div class="user-menu__section-label">ΛΟΓΑΡΙΑΣΜΟΣ</div>
                @if (!string.IsNullOrWhiteSpace(CsrfToken))
                {
                    <form method="post" action="/ui/session/logout" class="logout-form user-menu__logout">
                        <input type="hidden" name="__RequestVerificationToken" value="@CsrfToken" />
                        <button type="submit"><AppIcon Name="logout" /> Αποσύνδεση</button>
                    </form>
                }
            </div>
        </details>
    </div>
</header>

@code {
    [Parameter, EditorRequired] public string PageTitle { get; set; } = string.Empty;
    [Parameter] public string? BreadcrumbSection { get; set; }
    [Parameter] public string? BreadcrumbSectionHref { get; set; }
    [Parameter] public string ActivePage { get; set; } = "dashboard";
    [Parameter] public string UserName { get; set; } = "Χρήστης";
    [Parameter] public TenantWorkspaceSnapshot? Workspace { get; set; }
    [Parameter] public string? CsrfToken { get; set; }
    [Parameter] public Guid? TenantId { get; set; }
    [Parameter] public Guid? StoreId { get; set; }

    private string Initials =>
        string.IsNullOrWhiteSpace(UserName) ? "A" : UserName[..1].ToUpperInvariant();

    private TenantWorkspaceSnapshot? ActiveWorkspace =>
        Workspace is { Status: TenantWorkspaceStatus.Ready or TenantWorkspaceStatus.NoStores, Tenant: not null }
            ? Workspace : null;

    private string WorkspaceSelectionHref
    {
        get
        {
            if (ActiveWorkspace is not { } workspace)
            {
                return "/dashboard#workspace-selection";
            }

            string address = $"/dashboard?tenantId={workspace.Tenant!.TenantId:D}";
            if (workspace.Store is { } store)
            {
                address += $"&storeId={store.StoreId:D}";
            }

            return address + "#workspace-selection";
        }
    }

    private string DashboardHref => Href("/dashboard");
    private string CatalogHref => Href("/catalog");
    private string PriceListsHref => Href("/price-lists");

    private string Href(string path)
    {
        if (!TenantId.HasValue)
        {
            return path;
        }

        string url = $"{path}?tenantId={TenantId.Value:D}";
        return StoreId.HasValue ? $"{url}&storeId={StoreId.Value:D}" : url;
    }
}
