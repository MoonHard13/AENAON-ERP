@* Κοινή προσβάσιμη επικεφαλίδα ταξινόμησης για πίνακες καταλόγου. *@
<th scope="col" aria-sort="@(Active ? Descending ? "descending" : "ascending" : null)">
    <a class="catalog-sort-header @(Active ? "catalog-sort-header--active" : "")"
       href="@Href"
       aria-label="@($"{Label}: ταξινόμηση {(Active && !Descending ? "φθίνουσα" : "αύξουσα")}")">
        <span>@Label</span>
        <span class="catalog-sort-header__arrow" aria-hidden="true">
            @(Active ? Descending ? "↓" : "↑" : "↕")
        </span>
    </a>
</th>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Href { get; set; } = string.Empty;
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Descending { get; set; }
}
